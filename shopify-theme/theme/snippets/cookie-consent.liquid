{%- comment -%}
  Cookiebanner, der gemmer valget via Shopifys Customer Privacy API
  (window.Shopify.customerPrivacy.setTrackingConsent). Shopify, Shopify-pixels
  og apps, der bruger API'et, respekterer dermed valget automatisk.
  Afvis og accepter er lige synlige (Datatilsynets vejledning).
  Ikke-nødvendige scripts må kun indlæses efter samtykke – se docs/OPSAETNING.md.
{%- endcomment -%}
<div class="cookie" role="region" aria-label="{{ 'cookies.dialog_label' | t }}" hidden data-cookie>
  <div class="cookie__inner">
    <h2 class="h5 cookie__title">{{ settings.cookie_banner_heading | escape }}</h2>
    <div class="rte small cookie__text">
      {{ settings.cookie_banner_text }}
      {%- if settings.cookie_page != blank -%}
        <p><a href="{{ settings.cookie_page.url }}">{{ 'cookies.read_more' | t }}</a></p>
      {%- elsif settings.privacy_page != blank -%}
        <p><a href="{{ settings.privacy_page.url }}">{{ 'forms.privacy_link' | t }}</a></p>
      {%- endif -%}
    </div>

    <form class="cookie__prefs" hidden data-cookie-prefs>
      <fieldset>
        <legend class="visually-hidden">{{ 'cookies.customize' | t }}</legend>
        <label class="toggle">
          <input type="checkbox" checked disabled>
          <span class="toggle__ui" aria-hidden="true"></span>
          <span><strong>{{ 'cookies.necessary' | t }}</strong><span class="small muted">{{ 'cookies.necessary_text' | t }}</span></span>
        </label>
        <label class="toggle">
          <input type="checkbox" name="preferences" data-consent="preferences">
          <span class="toggle__ui" aria-hidden="true"></span>
          <span><strong>{{ 'cookies.preferences' | t }}</strong><span class="small muted">{{ 'cookies.preferences_text' | t }}</span></span>
        </label>
        <label class="toggle">
          <input type="checkbox" name="analytics" data-consent="analytics">
          <span class="toggle__ui" aria-hidden="true"></span>
          <span><strong>{{ 'cookies.analytics' | t }}</strong><span class="small muted">{{ 'cookies.analytics_text' | t }}</span></span>
        </label>
        <label class="toggle">
          <input type="checkbox" name="marketing" data-consent="marketing">
          <span class="toggle__ui" aria-hidden="true"></span>
          <span><strong>{{ 'cookies.marketing' | t }}</strong><span class="small muted">{{ 'cookies.marketing_text' | t }}</span></span>
        </label>
      </fieldset>
    </form>

    <div class="cookie__actions">
      <button type="button" class="btn btn--secondary btn--sm" data-cookie-action="reject">{{ 'cookies.reject_all' | t }}</button>
      <button type="button" class="btn btn--secondary btn--sm" data-cookie-action="customize" aria-expanded="false">{{ 'cookies.customize' | t }}</button>
      <button type="button" class="btn btn--secondary btn--sm" data-cookie-action="save" hidden>{{ 'cookies.save' | t }}</button>
      <button type="button" class="btn btn--secondary btn--sm" data-cookie-action="accept">{{ 'cookies.accept_all' | t }}</button>
    </div>
    <p class="visually-hidden" aria-live="polite" data-cookie-status></p>
  </div>
</div>
