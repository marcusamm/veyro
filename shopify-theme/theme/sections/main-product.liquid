{%- comment -%}
  Produktside til pakker, betalte audits og digitale produkter.
  Bruger Shopifys produktformular og checkout (inkl. dynamiske betalingsknapper).
{%- endcomment -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}
<section class="section section--light product">
  <div class="container product__inner">
    <div class="product__media">
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 1400 | image_tag: widths: '500, 800, 1100, 1400', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'eager', fetchpriority: 'high', class: 'product__image' }}
      {%- else -%}
        <div class="product__placeholder" aria-hidden="true">{% render 'icon', name: 'layers', size: 56 %}</div>
      {%- endif -%}
    </div>

    <div class="product__info">
      <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
        <ol role="list">
          <li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
          {%- if collection -%}<li><a href="{{ collection.url }}">{{ collection.title | escape }}</a></li>{%- endif -%}
          <li><span aria-current="page">{{ product.title | escape }}</span></li>
        </ol>
      </nav>
      {%- if product.type != blank -%}<p class="eyebrow">{{ product.type | escape }}</p>{%- endif -%}
      <h1 class="h1">{{ product.title | escape }}</h1>

      <div class="product__price" data-price>
        <span class="visually-hidden">{{ 'products.price' | t }}</span>
        <span class="product__price-current">{{ current_variant.price | money }}</span>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <s class="muted"><span class="visually-hidden">{{ 'products.regular_price' | t }}</span>{{ current_variant.compare_at_price | money }}</s>
        {%- endif -%}
        {%- if cart.taxes_included -%}<span class="small muted">{{ 'products.tax_included' | t }}</span>{%- endif -%}
      </div>

      {%- form 'product', product, id: 'ProductForm', class: 'product__form' -%}
        {%- unless product.has_only_default_variant -%}
          <div class="field">
            <label for="ProductVariant">{{ 'products.options' | t }}</label>
            <div class="select">
              <select id="ProductVariant" name="id" data-variant-select>
                {%- for variant in product.variants -%}
                  <option value="{{ variant.id }}" data-price="{{ variant.price | money | escape }}"{% if variant == current_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>
                    {{ variant.title | escape }}{% unless variant.available %} – {{ 'products.sold_out' | t }}{% endunless %}
                  </option>
                {%- endfor -%}
              </select>
              {% render 'icon', name: 'arrow-down', size: 18 %}
            </div>
          </div>
        {%- else -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {%- endunless -%}

        <div class="product__buttons">
          <button type="submit" name="add" class="btn btn--secondary btn--block"{% unless current_variant.available %} disabled{% endunless %}>
            {%- if current_variant.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
          </button>
          {%- if section.settings.show_dynamic_checkout -%}
            {{ form | payment_button }}
          {%- endif -%}
        </div>
      {%- endform -%}

      <div class="rte product__description">{{ product.description }}</div>

      {%- if section.settings.note != blank -%}
        <div class="product__note">{% render 'icon', name: 'chat', size: 20 %}<div class="rte small">{{ section.settings.note }}</div></div>
      {%- endif -%}
    </div>
  </div>
</section>

{%- capture product_schema -%}
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | json }},
  "url": {{ request.origin | append: product.url | json }},
  {%- if product.featured_image -%}"image": {{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }},{%- endif -%}
  "offers": {
    "@type": "Offer",
    "price": {{ current_variant.price | divided_by: 100.0 | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "availability": "https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}"
  }
}
{%- endcapture -%}
<script type="application/ld+json">{{ product_schema }}</script>

{% schema %}
{
  "name": "Produkt / pakke",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Vis dynamiske betalingsknapper", "info": "F.eks. Shop Pay, Apple Pay og MobilePay, hvis de er aktiveret i Shopify Payments.", "default": true },
    { "type": "richtext", "id": "note", "label": "Note under beskrivelsen", "default": "<p>I tvivl om pakken passer til din hjemmeside? <a href=\"/pages/kontakt\">Skriv til os</a> før du køber.</p>" }
  ]
}
{% endschema %}
