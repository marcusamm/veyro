<section class="section section--light">
  <div class="container">
    <h1 class="h1">{{ section.settings.heading | escape }}</h1>
    <ul class="packages__grid" role="list">
      {%- for collection in collections -%}
        {%- if collection.products_count > 0 -%}
          <li class="card card--interactive">
            <h2 class="h4"><a class="card__link" href="{{ collection.url }}">{{ collection.title | escape }}</a></h2>
            <p class="muted">{{ collection.description | strip_html | truncatewords: 20 }}</p>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{ "name": "Alle kollektioner", "tag": "div", "settings": [ { "type": "text", "id": "heading", "label": "Overskrift", "default": "Pakker og ydelser" } ] }
{% endschema %}
