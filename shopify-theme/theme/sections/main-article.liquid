<article class="section section--light article">
  <div class="container container--narrow">
    <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
      <ol role="list">
        <li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
        <li><a href="{{ blog.url }}">{{ blog.title | escape }}</a></li>
        <li><span aria-current="page">{{ article.title | escape }}</span></li>
      </ol>
    </nav>
    <h1 class="h1">{{ article.title | escape }}</h1>
    <p class="small muted">
      <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'date' }}</time>
      {%- if section.settings.show_author -%} · {{ 'blog.by' | t: author: article.author }}{%- endif -%}
    </p>
    {%- if article.image -%}
      <div class="article__image">{{ article.image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 900px) 820px, 100vw', loading: 'eager' }}</div>
    {%- endif -%}
    <div class="rte rte--long">{{ article.content }}</div>
    <p><a href="{{ blog.url }}">← {{ 'blog.back' | t: title: blog.title }}</a></p>
  </div>
</article>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ article.title | json }},
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "author": { "@type": "Person", "name": {{ article.author | json }} }
    {%- if article.image -%},"image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}{%- endif -%}
  }
</script>

{% schema %}
{ "name": "Artikel", "tag": "div", "settings": [ { "type": "checkbox", "id": "show_author", "label": "Vis forfatter", "default": true } ] }
{% endschema %}
