{%- comment -%}
  Tekniske kompetencer med et kodevindue (faneblade) som visuelt bevis på,
  hvordan løsningerne bygges. Kodeeksemplerne redigeres i temaeditoren.
{%- endcomment -%}
<section class="section section--{{ section.settings.scheme }} caps" id="{{ section.settings.anchor | default: section.id | handle }}">
  <div class="container">
    {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text %}

    <div class="caps__inner">
      <ul class="caps__list" role="list">
        {%- for block in section.blocks -%}
          <li class="cap" data-reveal {{ block.shopify_attributes }}>
            <div class="cap__head">
              <span class="cap__num" aria-hidden="true">{{ forloop.index }}</span>
              <h3 class="h4">{{ block.settings.title | escape }}</h3>
            </div>
            <div class="rte cap__text">{{ block.settings.text }}</div>
            {%- if block.settings.example != blank -%}
              <p class="cap__example"><span>{{ section.settings.example_label | escape }}</span> {{ block.settings.example | escape }}</p>
            {%- endif -%}
            {%- assign tags = block.settings.tags | split: ',' -%}
            {%- if block.settings.tags != blank -%}
              <ul class="cap__tags" role="list">
                {%- for t in tags -%}<li>{{ t | strip | escape }}</li>{%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.settings.show_code -%}
        <div class="caps__code" data-reveal>
          <div class="code-window" data-tabs>
            <div class="code-window__bar">
              <span class="hv__dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <div class="code-window__tabs" role="tablist" aria-label="{{ section.settings.code_label | escape }}">
                {%- assign tabs = 'code_1,code_2,code_3' | split: ',' -%}
                {%- for t in tabs -%}
                  {%- assign name_key = t | append: '_name' -%}
                  {%- if section.settings[t] != blank -%}
                    <button type="button" role="tab" class="code-window__tab" id="CodeTab-{{ section.id }}-{{ forloop.index }}" aria-controls="CodePanel-{{ section.id }}-{{ forloop.index }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"{% unless forloop.first %} tabindex="-1"{% endunless %}>{{ section.settings[name_key] | escape }}</button>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
            {%- comment -%} Kodeeksempler gemmes med [[ ]] og [% %] i stedet for Liquid-tegn, som Shopify ikke tillader i indstillinger. {%- endcomment -%}
            {%- liquid
              assign lq_out_open = '{' | append: '{'
              assign lq_out_close = '}' | append: '}'
              assign lq_tag_open = '{' | append: '%'
              assign lq_tag_close = '%' | append: '}'
            -%}
            {%- for t in tabs -%}
              {%- if section.settings[t] != blank -%}
                <div class="code-window__panel" role="tabpanel" id="CodePanel-{{ section.id }}-{{ forloop.index }}" aria-labelledby="CodeTab-{{ section.id }}-{{ forloop.index }}" tabindex="0">
                  <pre><code>{{ section.settings[t] | replace: '[[', lq_out_open | replace: ']]', lq_out_close | replace: '[%', lq_tag_open | replace: '%]', lq_tag_close | escape }}</code></pre>
                </div>
              {%- endif -%}
            {%- endfor -%}
            <p class="code-window__caption">{{ section.settings.code_caption | escape }}</p>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tekniske kompetencer",
  "tag": "div",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Farvetema", "options": [
      { "value": "light", "label": "Lyst" }, { "value": "surface", "label": "Lys flade" }, { "value": "dark", "label": "Mørkt" }
    ], "default": "dark" },
    { "type": "text", "id": "anchor", "label": "Anker-id", "default": "kompetencer" },
    { "type": "text", "id": "eyebrow", "label": "Lille overskrift", "default": "Det kan vi bygge" },
    { "type": "inline_richtext", "id": "heading", "label": "Overskrift", "default": "Skræddersyet til din forretning" },
    { "type": "richtext", "id": "text", "label": "Tekst" },
    { "type": "text", "id": "example_label", "label": "Mærkat for eksempel", "default": "Eksempel:" },
    { "type": "header", "content": "Kodevindue" },
    { "type": "checkbox", "id": "show_code", "label": "Vis kodevindue", "default": true },
    { "type": "text", "id": "code_label", "label": "Skjult label", "default": "Kodeeksempler" },
    { "type": "text", "id": "code_1_name", "label": "Fane 1", "default": "section.liquid" },
    { "type": "textarea", "id": "code_1", "label": "Kode 1" },
    { "type": "text", "id": "code_2_name", "label": "Fane 2", "default": "schema.json" },
    { "type": "textarea", "id": "code_2", "label": "Kode 2" },
    { "type": "text", "id": "code_3_name", "label": "Fane 3", "default": "webhook.js" },
    { "type": "textarea", "id": "code_3", "label": "Kode 3" },
    { "type": "text", "id": "code_caption", "label": "Billedtekst", "default": "Forenklede eksempler på den type kode, vi skriver." }
  ],
  "blocks": [
    { "type": "capability", "name": "Kompetence", "settings": [
      { "type": "text", "id": "title", "label": "Titel", "default": "Custom sektioner" },
      { "type": "richtext", "id": "text", "label": "Tekst" },
      { "type": "text", "id": "example", "label": "Eksempel" },
      { "type": "text", "id": "tags", "label": "Teknologier (kommasepareret)", "default": "Liquid, JSON" }
    ] }
  ],
  "presets": [{ "name": "Tekniske kompetencer", "blocks": [{ "type": "capability" }, { "type": "capability" }] }]
}
{% endschema %}
