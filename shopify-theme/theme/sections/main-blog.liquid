{%- paginate blog.articles by 9 -%}
<section class="section section--light blog">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 class="h1">{{ blog.title | escape }}</h1>
    </header>
    {%- if blog.articles.size > 0 -%}
      <ul class="packages__grid" role="list">
        {%- for article in blog.articles -%}
          <li>
            <article class="card card--interactive article-card">
              {%- if article.image -%}
                <div class="package__media">{{ article.image | image_url: width: 800 | image_tag: widths: '400, 600, 800', sizes: '(min-width: 990px) 33vw, 100vw', loading: 'lazy' }}</div>
              {%- endif -%}
              <p class="small muted"><time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'date' }}</time></p>
              <h2 class="h4"><a class="card__link" href="{{ article.url }}">{{ article.title | escape }}</a></h2>
              <p class="muted">{{ article.excerpt_or_content | strip_html | truncatewords: 26 }}</p>
              <span class="service-card__cta" aria-hidden="true">{{ 'blog.read_article' | t }} {% render 'icon', name: 'arrow-up-right', size: 18 %}</span>
            </article>
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- else -%}
      <p class="muted">{{ 'blog.empty' | t }}</p>
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog", "tag": "div", "settings": [ { "type": "text", "id": "eyebrow", "label": "Lille overskrift", "default": "Viden" } ] }
{% endschema %}
