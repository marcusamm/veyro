{%- comment -%} Kurv til pakker og betalte ydelser. Betaling foregår i Shopifys checkout. {%- endcomment -%}
<section class="section section--light cart">
  <div class="container container--narrow">
    <h1 class="h1">{{ 'cart.title' | t }}</h1>
    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate class="cart__form">
        <table class="cart__table">
          <thead>
            <tr><th scope="col">{{ 'cart.item' | t }}</th><th scope="col">{{ 'products.quantity' | t }}</th><th scope="col" class="cart__right">{{ 'cart.total' | t }}</th></tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr>
                <td>
                  <a href="{{ item.url }}" class="cart__title">{{ item.product.title | escape }}</a>
                  {%- unless item.product.has_only_default_variant -%}<p class="small muted">{{ item.variant.title | escape }}</p>{%- endunless -%}
                  {%- if item.selling_plan_allocation -%}
                    {%- assign has_subscription = true -%}
                    <p class="sub-terms sub-terms--sm">{% render 'icon', name: 'automation', size: 14 %}<span>{{ item.selling_plan_allocation.selling_plan.name | escape }}</span></p>
                  {%- endif -%}
                  <a class="small" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}<span class="visually-hidden">: {{ item.product.title | escape }}</span></a>
                </td>
                <td>
                  <label class="visually-hidden" for="Qty-{{ item.key }}">{{ 'products.quantity' | t }}: {{ item.product.title | escape }}</label>
                  <input class="cart__qty" type="number" id="Qty-{{ item.key }}" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric">
                </td>
                <td class="cart__right">{{ item.final_line_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
        <div class="field">
          <label for="CartNote">{{ 'cart.note' | t }} <span class="field__opt">({{ 'forms.optional' | t }})</span></label>
          <textarea id="CartNote" name="note" rows="3">{{ cart.note }}</textarea>
        </div>
        {%- assign kontakt = pages['kontakt'].url | default: '/pages/kontakt' -%}
        <div class="cart__summary">
          <p class="cart__subtotal"><span>{{ 'cart.subtotal' | t }}</span> <strong>{{ cart.total_price | money_with_currency }}</strong></p>
          {%- if has_subscription -%}<p class="sub-terms">{% render 'icon', name: 'automation', size: 16 %}<span>{{ 'subscriptions.cart_note' | t }}</span></p>{%- endif -%}
          <p class="small muted">{{ 'cart.taxes_note' | t }}</p>
          <div class="cart__actions">
            <button type="submit" name="update" class="btn btn--secondary">{{ 'cart.update' | t }}</button>
            <button type="submit" name="checkout" class="btn btn--primary">{{ 'cart.checkout' | t }}</button>
          </div>
          <p class="small muted cart__quote">{{ 'subscriptions.cart_quote' | t }} <a href="{{ kontakt }}?ydelse=andet-ved-ikke-endnu#formular">{{ 'subscriptions.get_quote' | t }}</a>.</p>
        </div>
      </form>
    {%- else -%}
      <p class="lead">{{ 'cart.empty' | t }}</p>
      {%- assign services_url = pages['ydelser'].url | default: routes.root_url -%}
      {%- assign continue_label = 'cart.continue' | t -%}
      {%- assign plans_url = services_url | append: '#abonnement' -%}
      {%- assign plans_label = 'subscriptions.see_plans' | t -%}
      <div class="cart__empty-actions">
        {% render 'button', label: plans_label, url: plans_url, style: 'primary', arrow: settings.button_arrow %}
        {% render 'button', label: continue_label, url: services_url, style: 'secondary' %}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Kurv", "tag": "div", "settings": [] }
{% endschema %}
