{%- comment -%}
  Mindre, tydelig besked med op til to knapper. Bruges til supplerende tilbud.
{%- endcomment -%}
<section class="section section--{{ section.settings.scheme }} note-banner" id="{{ section.settings.anchor | default: section.id | handle }}">
  <div class="container">
    <div class="note-banner__box" data-reveal>
      {%- if section.settings.icon != 'none' -%}<span class="note-banner__icon">{% render 'icon', name: section.settings.icon, size: 24 %}</span>{%- endif -%}
      <div class="note-banner__content">
        <h2 class="h3 note-banner__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="rte note-banner__text">{{ section.settings.text }}</div>{%- endif -%}
      </div>
      <div class="note-banner__actions">
        {% render 'button', label: section.settings.primary_label, url: section.settings.primary_link, style: 'secondary' %}
        {% render 'button', label: section.settings.secondary_label, url: section.settings.secondary_link, style: 'link' %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kort besked",
  "tag": "div",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Farvetema", "options": [
      { "value": "light", "label": "Lyst" }, { "value": "surface", "label": "Lys flade" }, { "value": "dark", "label": "Mørkt" }
    ], "default": "light" },
    { "type": "text", "id": "anchor", "label": "Anker-id", "default": "hjemmesider" },
    { "type": "select", "id": "icon", "label": "Ikon", "options": [
      { "value": "none", "label": "Intet" }, { "value": "design", "label": "Hjemmeside" }, { "value": "chat", "label": "Dialog" }, { "value": "layers", "label": "Lag" }
    ], "default": "design" },
    { "type": "inline_richtext", "id": "heading", "label": "Overskrift", "default": "Har du blot brug for en hjemmeside? Det laver vi også." },
    { "type": "richtext", "id": "text", "label": "Tekst" },
    { "type": "text", "id": "primary_label", "label": "Knaptekst" },
    { "type": "url", "id": "primary_link", "label": "Knaplink" },
    { "type": "text", "id": "secondary_label", "label": "Linktekst" },
    { "type": "url", "id": "secondary_link", "label": "Link" }
  ],
  "presets": [{ "name": "Kort besked" }]
}
{% endschema %}
