{%- comment -%}
  Udvidelse: faste pakker, betalte audits eller digitale produkter oprettet som
  Shopify-produkter i en kollektion. Køb går via Shopifys egen checkout.
  Sektionen vises ikke på den live side, før der er valgt en kollektion med produkter.
{%- endcomment -%}
{%- assign collection = section.settings.collection -%}
{%- if collection.products_count > 0 -%}
  <section class="section section--{{ section.settings.scheme }} packages" id="{{ section.settings.anchor | default: section.id | handle }}">
    <div class="container">
      {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text %}
      <ul class="packages__grid" role="list">
        {%- for product in collection.products limit: section.settings.limit -%}
          <li data-reveal>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <section class="section section--surface">
    <div class="container"><p class="editor-note">{{ 'products.packages_empty' | t }}</p></div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Pakker (produkter)",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "Til fastprispakker, betalte audits eller digitale produkter. Opret dem som produkter, saml dem i en kollektion og vælg den her." },
    { "type": "select", "id": "scheme", "label": "Farvetema", "options": [
      { "value": "light", "label": "Lyst" }, { "value": "surface", "label": "Lys flade" }, { "value": "dark", "label": "Mørkt" }
    ], "default": "surface" },
    { "type": "text", "id": "anchor", "label": "Anker-id", "default": "pakker" },
    { "type": "collection", "id": "collection", "label": "Kollektion" },
    { "type": "range", "id": "limit", "label": "Antal pakker", "min": 1, "max": 12, "step": 1, "default": 3 },
    { "type": "text", "id": "eyebrow", "label": "Lille overskrift", "default": "Pakker" },
    { "type": "inline_richtext", "id": "heading", "label": "Overskrift", "default": "Faste pakker med klar pris" },
    { "type": "richtext", "id": "text", "label": "Tekst" }
  ],
  "presets": [{ "name": "Pakker (produkter)" }]
}
{% endschema %}
