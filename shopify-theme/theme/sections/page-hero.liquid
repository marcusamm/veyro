{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = page.title | default: page_title | escape
  endif
-%}
<section class="section section--{{ section.settings.scheme }} page-hero{% if section.settings.style == 'technical' %} page-hero--technical{% endif %}">
  <div class="hero__grid-bg" aria-hidden="true"></div>
  <div class="container page-hero__inner">
    {%- if section.settings.show_breadcrumbs and request.page_type != 'index' -%}
      <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
        <ol role="list">
          <li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
          <li><span aria-current="page">{{ page.title | default: page_title | escape }}</span></li>
        </ol>
      </nav>
    {%- endif -%}
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" data-reveal>{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h1 class="h-display page-hero__title" data-reveal>{{ heading }}</h1>
    {%- if section.settings.text != blank -%}<div class="lead page-hero__text rte" data-reveal>{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
      <div class="hero__actions" data-reveal>
        {% render 'button', label: section.settings.primary_label, url: section.settings.primary_link, fallback: pages['kontakt'].url, style: 'primary', arrow: settings.button_arrow %}
        {% render 'button', label: section.settings.secondary_label, url: section.settings.secondary_link, style: 'secondary' %}
      </div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <nav class="anchor-nav" aria-label="{{ section.settings.nav_label | escape }}" data-reveal>
        <p class="anchor-nav__label">{{ section.settings.nav_label | escape }}</p>
        <ul role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}><a href="#{{ block.settings.target | handle }}">{{ block.settings.label | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Sidetop",
  "tag": "div",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Farvetema", "options": [
      { "value": "light", "label": "Lyst" }, { "value": "surface", "label": "Lys flade" }, { "value": "dark", "label": "Mørkt" }
    ], "default": "light" },
    { "type": "select", "id": "style", "label": "Baggrund", "options": [
      { "value": "plain", "label": "Ren" }, { "value": "technical", "label": "Teknisk gitter" }
    ], "default": "technical" },
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Vis brødkrummer", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Lille overskrift" },
    { "type": "inline_richtext", "id": "heading", "label": "Overskrift", "info": "Tomt felt bruger sidens titel." },
    { "type": "richtext", "id": "text", "label": "Tekst" },
    { "type": "text", "id": "primary_label", "label": "Primær knap" },
    { "type": "url", "id": "primary_link", "label": "Primært link", "info": "Tomt felt linker til siden „kontakt“." },
    { "type": "text", "id": "secondary_label", "label": "Sekundær knap" },
    { "type": "url", "id": "secondary_link", "label": "Sekundært link" },
    { "type": "text", "id": "nav_label", "label": "Overskrift over genveje", "default": "Gå til" }
  ],
  "blocks": [
    { "type": "anchor", "name": "Genvej", "settings": [
      { "type": "text", "id": "label", "label": "Tekst", "default": "Ydelse" },
      { "type": "text", "id": "target", "label": "Anker-id på sektionen", "default": "ydelse" }
    ] }
  ],
  "presets": [{ "name": "Sidetop" }]
}
{% endschema %}
