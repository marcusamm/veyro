<section class="section section--dark password">
  <div class="container container--narrow">
    <p class="logo"><span class="logo__text">{{ settings.company_name | default: shop.name | escape }}</span><span class="logo__dot" aria-hidden="true">.</span></p>
    <h1 class="h-display">{{ section.settings.heading | default: shop.name | escape }}</h1>
    {%- if shop.password_message != blank -%}<p class="lead">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'storefront_password', class: 'password__form' -%}
      {%- if form.errors -%}<p class="field__error" role="alert">{{ form.errors.messages['form'] }}</p>{%- endif -%}
      <div class="field">
        <label for="Password">{{ 'password.label' | t }}</label>
        <input type="password" name="password" id="Password" autocomplete="current-password" required>
      </div>
      <button type="submit" class="btn btn--primary">{{ 'password.submit' | t }}</button>
    {%- endform -%}
    <p class="small muted">{{ 'password.owner' | t }} <a href="/admin">{{ 'password.login' | t }}</a></p>
  </div>
</section>

{% schema %}
{ "name": "Adgangskode", "tag": "div", "settings": [ { "type": "text", "id": "heading", "label": "Overskrift", "default": "Vi åbner snart" } ] }
{% endschema %}
