{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'gift_card.title' | t }} – {{ shop.name | escape }}</title>
    {%- render 'theme-styles' -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main class="section section--light">
      <div class="container container--narrow">
        <h1 class="h1">{{ 'gift_card.title' | t }}</h1>
        <p class="lead">{{ 'gift_card.balance' | t }}: <strong>{{ gift_card.balance | money }}</strong></p>
        <p>{{ 'gift_card.code' | t }}: <code>{{ gift_card.code | format_code }}</code></p>
        <button class="btn btn--secondary" type="button" onclick="window.print()">{{ 'gift_card.print' | t }}</button>
      </div>
    </main>
  </body>
</html>
