{%- comment -%}
  Ens pakkekort til forsiden (sections/home-prices og home-drift), så priserne kan sammenlignes:
  navn og status øverst, pris, interval og momsnote altid samme sted, derefter indhold og knapper.
  Rammen (SVG) er fuldt optrukket fra start; theme.js (initFrames) tegner den én gang, når kortet
  kommer ind i billedet. Parametre: block, frame (bool)
{%- endcomment -%}
{%- assign s = block.settings -%}
{%- assign items = s.features | newline_to_br | split: '<br />' -%}
<li class="pc pc--{{ s.status }}"{% if frame %} data-frame{% endif %} id="pakke-{{ s.title | handle }}-forside" {{ block.shopify_attributes }}>
  {%- if frame -%}<svg class="pc__frame" aria-hidden="true" focusable="false"><rect width="100%" height="100%" rx="{{ settings.card_radius }}" ry="{{ settings.card_radius }}"/></svg>{%- endif -%}
  <div class="pc__top">
    <h3 class="pc__name">{{ s.title | escape }}</h3>
    {%- if s.badge != blank -%}<span class="pc__badge">{{ s.badge | escape }}</span>{%- endif -%}
  </div>
  <p class="pc__desc">{{ s.text | escape }}</p>
  <div class="pc__price">
    {%- if s.price_label != blank -%}<span class="pc__price-label">{{ s.price_label | escape }}</span>{%- endif -%}
    <span class="pc__amount"><strong>{{ s.price | escape }}</strong>{% if s.interval != blank %}<span>{{ s.interval | escape }}</span>{% endif %}</span>
    {%- if s.vat != blank -%}<span class="pc__vat">{{ s.vat | escape }}</span>{%- endif -%}
  </div>
  <ul class="pc__list" role="list">
    {%- for i in items -%}{%- assign line = i | strip -%}{%- if line != blank -%}<li>{{ line | escape }}</li>{%- endif -%}{%- endfor -%}
  </ul>
  <div class="pc__actions">
    {% render 'button', label: s.button_label, url: s.button_link, style: s.button_style, class: 'pc__btn' %}
    {%- if s.details_label != blank -%}<a class="pc__details" href="{{ s.details_link }}">{{ s.details_label | escape }}</a>{%- endif -%}
  </div>
</li>
