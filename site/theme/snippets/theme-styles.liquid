{%- comment -%}
  Design tokens. Alle farver, skrifttyper og mål styres fra Temaindstillinger
  og skrives som CSS-variabler, som assets/base.css bygger på.
{%- endcomment -%}
{%- liquid
  assign font_heading_family = '"Inter Tight", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif'
  assign font_body_family = '"Inter Tight", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif'
-%}
<style>
  @font-face {
    font-family: "Inter Tight";
    src: url("{{ 'inter-tight-latin-wght-normal.woff2' | asset_url }}") format("woff2");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "JetBrains Mono";
    src: url("{{ 'jetbrains-mono-latin-wght-normal.woff2' | asset_url }}") format("woff2");
    font-weight: 100 800;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --color-bg: {{ settings.color_bg }};
    --color-surface: {{ settings.color_surface }};
    --color-ink: {{ settings.color_ink }};
    --color-muted: {{ settings.color_muted }};
    --color-dark-bg: {{ settings.color_dark_bg }};
    --color-dark-surface: {{ settings.color_dark_surface }};
    --color-dark-ink: {{ settings.color_dark_ink }};
    --color-dark-muted: {{ settings.color_dark_muted }};
    --color-accent: {{ settings.color_accent }};
    --color-accent-rgb: {{ settings.color_accent.red }}, {{ settings.color_accent.green }}, {{ settings.color_accent.blue }};
    --color-accent-ink: {{ settings.color_accent_ink }};
    --color-success: {{ settings.color_success }};
    --color-error: {{ settings.color_error }};
    --ink-rgb: {{ settings.color_ink.red }}, {{ settings.color_ink.green }}, {{ settings.color_ink.blue }};
    --dark-ink-rgb: {{ settings.color_dark_ink.red }}, {{ settings.color_dark_ink.green }}, {{ settings.color_dark_ink.blue }};

    --font-heading: {{ font_heading_family }};
    --font-body: {{ font_body_family }};
    --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    --heading-weight: {{ settings.heading_weight }};
    --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
    --body-scale: {{ settings.body_scale | divided_by: 100.0 }};

    --page-width: {{ settings.page_width }}px;
    --section-spacing: {{ settings.section_spacing | divided_by: 100.0 }};
    --radius-button: {{ settings.button_radius }}px;
    --radius-card: {{ settings.card_radius }}px;
    --logo-width: {{ settings.logo_width }}px;
  }
</style>
