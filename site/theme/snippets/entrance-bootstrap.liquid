{%- comment -%} Runs before the first body paint; the default/no-JS page remains fully visible. {%- endcomment -%}
<script>
(() => {
  const root = document.documentElement;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const inputs = ['pointerdown', 'keydown', 'wheel', 'touchstart', 'focusin'];
  let active = false;
  let revealTimer, finishTimer;

  function paused() {
    try { return sessionStorage.getItem('veyro-effects-paused') === 'true'; }
    catch (_) { return document.body?.classList.contains('effects-paused') || false; }
  }
  function announce(type) { window.dispatchEvent(new Event(type)); }
  function finish() {
    if (!active) return;
    active = false;
    clearTimeout(revealTimer);
    clearTimeout(finishTimer);
    delete root.dataset.entrance;
    window.VeyroEntrance.revealAt = 0;
    // Retain the one hidden element so a BFCache restoration can replay it.
    announce('veyro:entrance-reveal');
    for (const type of inputs) document.removeEventListener(type, finish, true);
  }
  function start() {
    if (reduced.matches || paused()) { finish(); return; }
    if (active) return;
    const overlay = document.querySelector('[data-site-entrance]');
    // Flush its hidden state before replaying CSS animations on a restored page.
    if (overlay) void overlay.offsetWidth;
    active = true;
    window.VeyroEntrance.revealAt = performance.now() + 900;
    root.dataset.entrance = 'opening';
    announce('veyro:entrance-start');
    if (!active) return;
    revealTimer = setTimeout(() => {
      if (!active) return;
      root.dataset.entrance = 'revealing';
      announce('veyro:entrance-reveal');
    }, 900);
    // Independent of fonts, images and motion.js: a failed enhancement cannot cover the page.
    finishTimer = setTimeout(finish, 2050);
    for (const type of inputs) document.addEventListener(type, finish, { capture: true, passive: true });
  }
  window.VeyroEntrance = { revealAt: 0, finish };
  window.addEventListener('pageshow', event => { if (event.persisted) start(); });
  window.addEventListener('pagehide', finish);
  window.addEventListener('beforeprint', finish);
  // Same-document section links dismiss an active entrance without starting another.
  window.addEventListener('hashchange', finish);
  reduced.addEventListener('change', () => { if (reduced.matches) finish(); });
  // Scroll restoration and a fresh hash target keep their native position. User
  // scrolling still dismisses immediately through wheel, touch, keys or pointer input.
  start();
})();
</script>
