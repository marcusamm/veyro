{%- comment -%}
  Kodet hero-illustration (ingen billedfiler = ingen ekstra indlæsning og ingen layoutskift).
  Viser en side, Googles Core Web Vitals-grænseværdier og en optimeringsplan.
  Bemærk: Illustrationen viser ingen målte resultater – kun Googles officielle grænseværdier.
{%- endcomment -%}
<figure class="hv" role="img" aria-label="Illustration af en hjemmeside med Core Web Vitals-målepunkter og en optimeringsplan">
  <div class="hv__window" aria-hidden="true">
    <div class="hv__bar">
      <span class="hv__dots"><i></i><i></i><i></i></span>
      <span class="hv__url">ditdomæne.dk/produkt</span>
    </div>
    <div class="hv__page">
      <div class="hv__media">
        <span class="hv__shine"></span>
      </div>
      <div class="hv__info">
        <span class="hv__line hv__line--sm"></span>
        <span class="hv__line hv__line--lg"></span>
        <span class="hv__line hv__line--md"></span>
        <span class="hv__swatches"><i></i><i></i><i></i></span>
        <span class="hv__atc">Læg i kurv</span>
        <span class="hv__line hv__line--xs"></span>
        <span class="hv__line hv__line--sm"></span>
      </div>
    </div>
  </div>

  <div class="hv__card hv__vitals" aria-hidden="true">
    <p class="hv__label">Core Web Vitals <span>Googles mål for „god“</span></p>
    <ul>
      <li><b>LCP</b><span class="hv__meter"><i style="--to: 22%"></i></span><em>≤ 2,5 s</em></li>
      <li><b>INP</b><span class="hv__meter"><i style="--to: 18%"></i></span><em>≤ 200 ms</em></li>
      <li><b>CLS</b><span class="hv__meter"><i style="--to: 14%"></i></span><em>≤ 0,1</em></li>
    </ul>
  </div>

  <div class="hv__card hv__plan" aria-hidden="true">
    <p class="hv__label">Optimeringsplan</p>
    <ol>
      <li><span class="hv__tick"></span>Billeder i rette størrelse</li>
      <li><span class="hv__tick"></span>Ubrugte scripts fjernet</li>
      <li><span class="hv__tick"></span>Klarere produktside</li>
      <li><span class="hv__tick hv__tick--todo"></span>Checkout-flow testet</li>
    </ol>
  </div>
</figure>
