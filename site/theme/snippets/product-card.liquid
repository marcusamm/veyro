{%- comment -%} Kort for en pakke/ydelse oprettet som Shopify-produkt. Parametre: product {%- endcomment -%}
<article class="package card card--interactive">
  {%- if product.featured_media -%}
    <div class="package__media">
      {{ product.featured_media | image_url: width: 800 | image_tag: widths: '400, 600, 800', sizes: '(min-width: 990px) 33vw, 100vw', loading: 'lazy', alt: product.featured_media.alt | default: product.title }}
    </div>
  {%- endif -%}
  {%- if product.type != blank -%}<p class="tag">{{ product.type | escape }}</p>{%- endif -%}
  <h3 class="h4"><a class="card__link" href="{{ product.url }}">{{ product.title | escape }}</a></h3>
  {%- if product.description != blank -%}
    <p class="muted">{{ product.description | strip_html | truncatewords: 22 }}</p>
  {%- endif -%}
  <p class="package__price">
    {%- if product.price_varies -%}
      {%- assign min_price = product.price_min | money -%}
      {{ 'products.from_price' | t: price: min_price }}
    {%- else -%}
      {{ product.price | money }}
    {%- endif -%}
    {%- unless product.available -%}<span class="tag tag--muted">{{ 'products.sold_out' | t }}</span>{%- endunless -%}
  </p>
  <span class="service-card__cta" aria-hidden="true">{{ 'products.view' | t }} {% render 'icon', name: 'arrow-up-right', size: 18 %}</span>
</article>
