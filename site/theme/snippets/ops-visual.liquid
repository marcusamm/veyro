{%- comment -%}
  Kodet hero-illustration af et ordre- og lagersystem. Fiktive data, markeret som eksempel.
{%- endcomment -%}
<figure class="hv ov" role="img" aria-label="Eksempel med fiktive data: ordreoversigt med nye ordrer og en lageroversigt med advarsel om lav beholdning">
  <span class="ov__badge" aria-hidden="true">Eksempel</span>
  <div class="hv__window" aria-hidden="true">
    <div class="hv__bar">
      <span class="hv__dots"><i></i><i></i><i></i></span>
      <span class="hv__url">Ordrer</span>
    </div>
    <div class="ov__orders">
      <div class="ov__tabs"><b>Nye 2</b><span>Igangværende 1</span><span>Afsluttede 1</span></div>
      <div class="ov__row"><span>#1048</span><span>M. Larsen</span><span class="ov__src">Hjemmeside</span><span class="pill pill--new">Ny</span></div>
      <div class="ov__row"><span>#1047</span><span>J. Holm</span><span class="ov__src">Telefon</span><span class="pill pill--new">Ny</span></div>
      <div class="ov__row"><span>#1046</span><span>S. Nielsen</span><span class="ov__src">E-mail</span><span class="pill pill--busy">I gang</span></div>
      <div class="ov__row"><span>#1045</span><span>A. Berg</span><span class="ov__src">Direkte salg</span><span class="pill pill--done">Afsluttet</span></div>
    </div>
  </div>

  <div class="hv__card ov__toast" aria-hidden="true">{% render 'icon', name: 'bell', size: 14 %}<span>Ny ordre #1048<em>3 varer reserveret</em></span></div>

  <div class="hv__card ov__stock" aria-hidden="true">
    <p class="hv__label">Lager <span>disponibel</span></p>
    <ul>
      <li><span>Arbejdshandsker</span><b>96</b></li>
      <li class="is-low"><span>Malertape 25 mm</span><b>6</b><i>Lav</i></li>
      <li class="is-out"><span>Afdækningsplast</span><b>0</b><i>Udsolgt</i></li>
    </ul>
  </div>
</figure>
