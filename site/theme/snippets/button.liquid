{%- comment -%}
  Knap/link i temaets stil.
  Parametre: label, url, style ('primary'|'secondary'|'ghost'|'link'), arrow (bool), class, fallback (URL, hvis url er tom)
{%- endcomment -%}
{%- assign href = url | default: fallback -%}
{%- assign style = style | default: 'primary' -%}
{%- if label != blank and href != blank -%}
  <a class="btn btn--{{ style }} {{ class }}" href="{{ href }}">
    <span>{{ label | escape }}</span>
    {%- if arrow or style == 'link' -%}
      <span class="btn__icon">{% render 'icon', name: 'arrow-right', size: 18 %}</span>
    {%- endif -%}
  </a>
{%- endif -%}
