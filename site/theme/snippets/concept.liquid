{%- comment -%}
  Designkoncept: et skærmbillede af en af demoerne i public/demo, vist i et diskret browservindue med
  mærkning og link til hele demoen. Demoerne er fiktive virksomheder, og intet i dem bliver sendt,
  booket eller betalt. Skærmbillederne laves med scripts/demo-previews.mjs og skal tages igen, når en demo ændres.
  Parametre:
    name     'craft' (Holm Tømrer, forside) | 'salon' (Salon Nord, booking) | 'shop' (Lerværk, produktside)
    caption  kort tekst under billedet (valgfri)
    eager    true for eksemplet øverst på siden
  Bruges inde i <figure class="concept">.
{%- endcomment -%}
{%- liquid
  case name
    when 'salon'
      assign shot = 'salon-nord-booking'
      assign path = '/demo/salon-nord/book'
      assign title = 'Salon Nord'
      assign alt = 'public.concept_booking_alt' | t
    when 'shop'
      assign shot = 'lervaerk-produkt'
      assign path = '/demo/lervaerk/produkter/krus'
      assign title = 'Lerværk'
      assign alt = 'public.concept_product_alt' | t
    else
      assign shot = 'holm-tomrer'
      assign path = '/demo/holm-tomrer/'
      assign title = 'Holm Tømrer'
      assign alt = 'public.concept_home_alt' | t
  endcase
  if eager
    assign loading = 'eager'
    assign priority = 'high'
  else
    assign loading = 'lazy'
    assign priority = 'auto'
  endif
-%}
<div class="browser" data-concept="{{ name | default: 'craft' }}">
  <div class="browser__bar" aria-hidden="true"><span class="browser__url">veyro.dk{{ path }}</span></div>
  <a class="browser__shot" href="{{ path }}" tabindex="-1">
    <picture>
      <source media="(max-width: 599px)" srcset="/demo/_previews/{{ shot }}-mobil.jpg" width="780" height="1280">
      <img src="/demo/_previews/{{ shot }}-960.jpg" srcset="/demo/_previews/{{ shot }}-960.jpg 960w, /demo/_previews/{{ shot }}-1920.jpg 1920w" sizes="{% if wide %}(min-width: 1280px) 1152px, 100vw{% else %}(min-width: 990px) 58vw, 100vw{% endif %}" width="1920" height="1200" alt="{{ alt }}" loading="{{ loading }}" fetchpriority="{{ priority }}" decoding="async">
    </picture>
  </a>
</div>
<figcaption class="concept__cap">
  <span class="badge">{{ 'public.fictional_concept_credit' | t }}</span>
  {%- if caption != blank -%}<span>{{ caption | escape }}</span>{%- endif -%}
  <a class="arrow-link" href="{{ path }}">{{ 'public.open_demo' | t }}<span class="visually-hidden">: {{ title }}</span></a>
</figcaption>
