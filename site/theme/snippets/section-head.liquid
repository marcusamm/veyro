{%- comment -%}
  Fælles sektionshoved: lille label (bruges sparsomt), overskrift og intro.
  Parametre: eyebrow, heading, text (richtext), tag (h1/h2), size ('xl'|'lg'|'md'), id, class
{%- endcomment -%}
{%- assign tag = tag | default: 'h2' -%}
{%- assign size = size | default: 'lg' -%}
{%- if eyebrow != blank or heading != blank or text != blank -%}
  <header class="head{% if class %} {{ class }}{% endif %}">
    {%- if eyebrow != blank -%}<p class="label">{{ eyebrow | escape }}</p>{%- endif -%}
    {%- if heading != blank -%}
      <{{ tag }} class="head__title t-{{ size }}"{% if id %} id="{{ id }}"{% endif %}>{{ heading }}</{{ tag }}>
    {%- endif -%}
    {%- if text != blank -%}<div class="head__text rte">{{ text }}</div>{%- endif -%}
  </header>
{%- endif -%}
