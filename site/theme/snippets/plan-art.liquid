{%- comment -%}Decorative, original illustrations of the three existing package types. No live customer data.{%- endcomment -%}
<div class="plan-art plan-art--{{ key }}" aria-hidden="true">
  {%- case key -%}
  {%- when 'booking' -%}
    <div class="plan-art__calendar"><div class="plan-art__bar"><span>Din kalender</span><span>← &nbsp; →</span></div><div class="plan-art__week"><span>Ma</span><span>Ti</span><span>On</span><span>To</span><span>Fr</span><span>Lø</span><span>Sø</span><i>1</i><i>2</i><i class="plan-art__day">3</i><i>4</i><i>5</i><i>6</i><i>7</i></div><div class="plan-art__slot"><span>10.30</span><b>En tid i kalenderen</b><span>✓</span></div></div>
    <p class="plan-art__fact">Mailbekræftelser · Op til 3 medarbejdere</p>
  {%- when 'webshop' -%}
    <div class="plan-art__shop"><div class="plan-art__product"><svg viewBox="0 0 110 85" fill="none"><path d="M26 20h48v33c0 14-9 23-24 23S26 67 26 53V20Z" fill="currentColor" opacity=".5"/><path d="M74 27h8c21 0 21 26 0 26h-8" stroke="currentColor" stroke-width="7"/><ellipse cx="50" cy="20" rx="24" ry="6" stroke="currentColor" stroke-width="2"/></svg><span>Et produkt. Flere varianter.</span><div><i></i><i></i><i></i></div></div><div class="plan-art__order"><span>Webshop</span><b>Jeres varer,<br>jeres udtryk.</b><i></i><i></i><small>Produkter · Varianter · Kurv</small></div></div>
    <p class="plan-art__fact">Op til 50 produkter · 200 varianter</p>
  {%- else -%}
    <div class="plan-art__browser"><div class="plan-art__bar"><span>● ● ●</span><span>jeresnavn.veyro.dk</span></div><div class="plan-art__web"><div><span>Jeres virksomhed</span><b>Et sted at<br>møde jer.</b><i></i></div><div class="plan-art__picture"><svg viewBox="0 0 80 90" fill="none"><path d="m10 18 30 52 30-52" stroke="currentColor" stroke-width="7" stroke-linecap="round"/></svg></div></div><div class="plan-art__tabs"><span>Forside</span><span>Ydelser</span><span>Om jer</span><span>Kontakt</span></div></div>
    <p class="plan-art__fact">Op til 5 sider · 3 korrekturrunder</p>
  {%- endcase -%}
</div>
