{%- comment -%}
  Kort formular til gratis vurdering: URL, største udfordring og e-mail.
  Sendes til /contact og gemmes som forespørgsel i admin. Brug kun én kontakt- eller
  vurderingsformular pr. side, så succesbeskeden vises det rigtige sted.
{%- endcomment -%}
{%- liquid
  assign fid = 'Assessment-' | append: section.id
  assign challenges = section.settings.challenges | newline_to_br | split: '<br />'
  assign submit_default = 'forms.submit_assessment' | t
-%}
<section class="section section--{{ section.settings.scheme }} assessment" id="{{ section.settings.anchor | default: section.id | handle }}">
  <div class="container assessment__inner">
    <div class="assessment__intro">
      {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text %}
      {%- assign points = section.settings.points | newline_to_br | split: '<br />' -%}
      {%- if section.settings.points != blank -%}
        <ul class="checklist checklist--lg" role="list">
          {%- for p in points -%}
            {%- assign point = p | strip -%}
            {%- if point != blank -%}<li>{% render 'icon', name: 'check', size: 18 %}<span>{{ point | escape }}</span></li>{%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="assessment__card card">
      {%- form 'contact', id: fid, class: 'form js-validate', novalidate: 'novalidate' -%}
        {% render 'form-status', form: form, success_heading: section.settings.success_heading, success_text: section.settings.success_text %}
        {%- unless form.posted_successfully? -%}
          <div class="form__error-summary" role="alert" tabindex="-1" hidden data-error-summary></div>
          <input type="hidden" name="contact[Formular]" value="{{ section.settings.form_name | escape }}">

          <div class="field">
            <label for="{{ fid }}-url">{{ section.settings.url_label | escape }} <span class="req" aria-hidden="true">*</span></label>
            <input type="text" id="{{ fid }}-url" name="contact[Hjemmeside]" inputmode="url" autocomplete="url" spellcheck="false" autocapitalize="off" required maxlength="200" placeholder="{{ 'forms.placeholders.store_url' | t }}" data-type="url" data-label="{{ section.settings.url_label | escape }}" aria-describedby="{{ fid }}-url-error">
            <p class="field__error" id="{{ fid }}-url-error" hidden></p>
          </div>

          <fieldset class="field choice-group" data-required-group data-label="{{ 'forms.fields.challenge' | t }}" aria-describedby="{{ fid }}-challenge-error">
            <legend>{{ 'forms.fields.challenge' | t }} <span class="req" aria-hidden="true">*</span></legend>
            <div class="choice-group__options">
              {%- for c in challenges -%}
                {%- assign challenge = c | strip -%}
                {%- if challenge != blank -%}
                  <label class="choice">
                    <input type="radio" name="contact[Største udfordring]" value="{{ challenge | escape }}"{% if forloop.first %} required{% endif %}>
                    <span>{{ challenge | escape }}</span>
                  </label>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <p class="field__error" id="{{ fid }}-challenge-error" hidden></p>
          </fieldset>

          <div class="form__grid">
            <div class="field">
              <label for="{{ fid }}-email">{{ 'forms.fields.email' | t }} <span class="req" aria-hidden="true">*</span></label>
              <input type="email" id="{{ fid }}-email" name="contact[email]" autocomplete="email" inputmode="email" spellcheck="false" autocapitalize="off" required maxlength="160" placeholder="{{ 'forms.placeholders.email' | t }}" data-label="{{ 'forms.fields.email' | t }}" aria-describedby="{{ fid }}-email-error">
              <p class="field__error" id="{{ fid }}-email-error" hidden></p>
            </div>
            <div class="field">
              <label for="{{ fid }}-name">{{ 'forms.fields.name' | t }} <span class="field__opt">({{ 'forms.optional' | t }})</span></label>
              <input type="text" id="{{ fid }}-name" name="contact[name]" autocomplete="name" maxlength="120" placeholder="{{ 'forms.placeholders.name' | t }}">
            </div>
          </div>

          {% render 'form-consent', id: fid %}

          <button class="btn btn--primary btn--lg btn--block" type="submit" data-submit>
            <span>{{ section.settings.submit_label | default: submit_default | escape }}</span>
            {% render 'icon', name: 'arrow-right', size: 18 %}
          </button>
          <p class="small muted form__note">{{ section.settings.note | escape }}</p>
        {%- endunless -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gratis vurdering",
  "tag": "div",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Farvetema", "options": [
      { "value": "light", "label": "Lyst" }, { "value": "surface", "label": "Lys flade" }, { "value": "dark", "label": "Mørkt" }
    ], "default": "dark" },
    { "type": "text", "id": "anchor", "label": "Anker-id", "default": "vurdering" },
    { "type": "text", "id": "eyebrow", "label": "Lille overskrift", "default": "Gratis vurdering" },
    { "type": "inline_richtext", "id": "heading", "label": "Overskrift", "default": "Få et kvalificeret blik på din hjemmeside" },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Send os linket til din hjemmeside eller webshop, og fortæl hvad der fylder mest. Vi kigger på den og svarer inden for 24-48 timer med de forbedringer, vi vurderer giver mest mening.</p>" },
    { "type": "textarea", "id": "points", "label": "Punkter (én pr. linje)", "default": "Uforpligtende og gratis\nKonkrete observationer – ikke en standardrapport\nAlle platforme: Shopify, WordPress, WooCommerce m.fl." },
    { "type": "text", "id": "form_name", "label": "Formularens navn i e-mailen", "default": "Gratis vurdering" },
    { "type": "text", "id": "url_label", "label": "Label for URL", "default": "Link til din hjemmeside eller webshop" },
    { "type": "textarea", "id": "challenges", "label": "Udfordringer (én pr. linje)", "default": "Langsom hjemmeside\nFå besøgende køber\nProduktsiderne skal forbedres\nTekniske fejl eller begrænsninger\nIntegrationer og automatisering\nAndet" },
    { "type": "text", "id": "submit_label", "label": "Knaptekst", "default": "Få en gratis vurdering" },
    { "type": "text", "id": "note", "label": "Note under knappen", "default": "Vi bruger kun dine oplysninger til at besvare din henvendelse." },
    { "type": "text", "id": "success_heading", "label": "Succes – overskrift", "default": "Tak – vi kigger på din hjemmeside" },
    { "type": "richtext", "id": "success_text", "label": "Succes – tekst", "default": "<p>Vi har modtaget dit link og svarer på e-mail inden for 24-48 timer med vores vurdering.</p>" }
  ],
  "presets": [{ "name": "Gratis vurdering" }]
}
{% endschema %}
