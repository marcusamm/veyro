{%- comment -%} Fri tekst i læsevenlig bredde. {%- endcomment -%}
<section class="section rich-text" id="{{ section.settings.anchor | default: section.id | handle }}">
  <div class="container">
    <div class="rich-text__inner">
      {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
      <div class="rte rte--long">{{ section.settings.text }}</div>
      {%- if section.settings.link_label != blank -%}
        <div class="actions">{% render 'button', label: section.settings.link_label, url: section.settings.link, fallback: pages['kontakt'].url, style: 'secondary' %}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tekst",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker-id" },
    { "type": "text", "id": "eyebrow", "label": "Lille overskrift" },
    { "type": "inline_richtext", "id": "heading", "label": "Overskrift", "default": "Overskrift" },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Tekst</p>" },
    { "type": "text", "id": "link_label", "label": "Knaptekst" },
    { "type": "url", "id": "link", "label": "Knaplink" }
  ],
  "presets": [{ "name": "Tekst" }]
}
{% endschema %}
