{%- comment -%}
  Pakker med fast månedspris. Hver pakke er en blok, så indhold og status kan rettes i admin.
  Visning: "summary" (kort, fx på forsiden) eller "detail" (alt indhold og grænser, fx på prissiden).
  Alle priser vises ekskl. moms. "Mest populær" og lignende fremhævninger bruges ikke.
{%- endcomment -%}
{%- assign terms = section.settings.terms | split: '·' -%}
<section class="section packages packages--{{ section.settings.layout }}" id="{{ section.settings.anchor | default: section.id | handle }}">
  <div class="container">
    <div class="packages__head">
      {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text %}
      {%- if section.settings.terms != blank -%}
        <ul class="packages__terms" role="list">
          {%- for t in terms -%}{%- assign line = t | strip -%}{%- if line != blank -%}<li>{{ line | escape }}</li>{%- endif -%}{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    <ul class="pc-grid" role="list">
      {%- for block in section.blocks -%}
        {% render 'package-card', block: block, layout: section.settings.layout, id_suffix: section.settings.id_suffix %}
      {%- endfor -%}
    </ul>
    {%- if section.settings.note != blank -%}<div class="packages__note rte">{{ section.settings.note }}</div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Pakker og priser",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker-id", "default": "pakker" },
    { "type": "select", "id": "layout", "label": "Visning", "options": [
      { "value": "summary", "label": "Kort (fx forsiden)" }, { "value": "detail", "label": "Alt indhold (prissiden)" }
    ], "default": "summary" },
    { "type": "text", "id": "id_suffix", "label": "Tillæg til kortenes id", "info": "Bruges, hvis samme pakke vises flere steder på siden, fx -forside." },
    { "type": "text", "id": "eyebrow", "label": "Lille overskrift" },
    { "type": "inline_richtext", "id": "heading", "label": "Overskrift", "default": "Pakker" },
    { "type": "richtext", "id": "text", "label": "Tekst" },
    { "type": "text", "id": "terms", "label": "Fælles vilkår (adskilt med ·)", "default": "Gratis oprettelse · Første måned gratis · Ingen binding" },
    { "type": "richtext", "id": "note", "label": "Note under pakkerne" }
  ],
  "blocks": [
    { "type": "package", "name": "Pakke", "limit": 4, "settings": [
      { "type": "text", "id": "handle", "label": "Id (bruges i links, fx hjemmeside)", "info": "Ændr ikke id'et, hvis der linkes til pakken." },
      { "type": "text", "id": "title", "label": "Navn", "default": "Hjemmeside" },
      { "type": "select", "id": "status", "label": "Status", "options": [
        { "value": "available", "label": "Kan bestilles nu" }, { "value": "coming", "label": "På vej" }
      ], "default": "available" },
      { "type": "text", "id": "badge", "label": "Mærkat (kun ved På vej)", "default": "På vej" },
      { "type": "text", "id": "text", "label": "Kort beskrivelse" },
      { "type": "text", "id": "price_label", "label": "Tekst over prisen", "info": "Fx Forventet pris. Tomt felt for pakker, der kan bestilles." },
      { "type": "text", "id": "price", "label": "Pris", "default": "199 kr." },
      { "type": "text", "id": "interval", "label": "Interval", "default": "/md." },
      { "type": "text", "id": "vat", "label": "Momsnote", "default": "ekskl. moms" },
      { "type": "text", "id": "features_label", "label": "Overskrift over indhold", "default": "Det er med" },
      { "type": "textarea", "id": "features", "label": "Indhold (én pr. linje)" },
      { "type": "text", "id": "limits_label", "label": "Overskrift over grænser", "default": "Rammer" },
      { "type": "textarea", "id": "limits", "label": "Grænser (én pr. linje, vises i fuld visning)" },
      { "type": "richtext", "id": "note", "label": "Note (vises i fuld visning)" },
      { "type": "text", "id": "button_label", "label": "Knaptekst", "default": "Aftal en demo" },
      { "type": "url", "id": "button_link", "label": "Knaplink" },
      { "type": "select", "id": "button_style", "label": "Knaptype", "options": [
        { "value": "primary", "label": "Primær" }, { "value": "secondary", "label": "Sekundær" }
      ], "default": "primary" },
      { "type": "text", "id": "details_label", "label": "Link til detaljer – tekst" },
      { "type": "url", "id": "details_link", "label": "Link til detaljer" }
    ] }
  ],
  "presets": [{ "name": "Pakker og priser", "blocks": [{ "type": "package" }] }]
}
{% endschema %}
