{%- comment -%}
  Forsidens priser: det ene mørke område på siden. Ens pakkekort (snippets/price-card), så pris,
  interval og momsnote står samme sted. Ingen "Mest populær". Vilkårene står synligt over kortene.
{%- endcomment -%}
<section class="hpr" id="{{ section.settings.anchor | default: section.id | handle }}">
  <div class="container">
    <div class="hpr__head">
      <h2 class="h-big">{{ section.settings.heading }}</h2>
      <div class="hpr__intro">
        {%- if section.settings.text != blank -%}<div class="hpr__text">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.offer != blank -%}
          {%- assign offers = section.settings.offer | split: '·' -%}
          <ul class="hpr__offer" role="list">{%- for o in offers -%}<li>{{ o | strip | escape }}</li>{%- endfor -%}</ul>
        {%- endif -%}
        {%- if section.settings.offer_note != blank -%}<p class="hpr__offer-note">{{ section.settings.offer_note | escape }}</p>{%- endif -%}
      </div>
    </div>
    <ul class="pc-grid" role="list">
      {%- for block in section.blocks -%}{% render 'price-card', block: block, frame: true %}{%- endfor -%}
    </ul>
    {%- if section.settings.note != blank -%}<div class="hpr__note">{{ section.settings.note }}</div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Forside: priser",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker-id", "default": "priser" },
    { "type": "inline_richtext", "id": "heading", "label": "Overskrift", "default": "Priser" },
    { "type": "richtext", "id": "text", "label": "Tekst" },
    { "type": "text", "id": "offer", "label": "Vilkår (adskilt af ·)", "default": "Gratis oprettelse · Første måned gratis · Ingen binding" },
    { "type": "text", "id": "offer_note", "label": "Hvad vilkårene gælder" },
    { "type": "richtext", "id": "note", "label": "Note under pakkerne" }
  ],
  "blocks": [
    { "type": "package", "name": "Pakke", "limit": 4, "settings": [
      { "type": "text", "id": "title", "label": "Navn", "default": "Basis" },
      { "type": "select", "id": "status", "label": "Status", "options": [
        { "value": "available", "label": "Kan bestilles nu" }, { "value": "quote", "label": "Efter tilbud" }, { "value": "coming", "label": "På vej" }
      ], "default": "available" },
      { "type": "text", "id": "badge", "label": "Mærkat" },
      { "type": "text", "id": "text", "label": "Kort beskrivelse" },
      { "type": "text", "id": "price_label", "label": "Tekst over prisen", "info": "Fx Forventet pris" },
      { "type": "text", "id": "price", "label": "Pris", "default": "199 kr." },
      { "type": "text", "id": "interval", "label": "Interval", "default": "/md." },
      { "type": "text", "id": "vat", "label": "Momsnote", "default": "ekskl. moms" },
      { "type": "textarea", "id": "features", "label": "Indhold (én pr. linje)" },
      { "type": "text", "id": "button_label", "label": "Knaptekst" },
      { "type": "url", "id": "button_link", "label": "Knaplink" },
      { "type": "select", "id": "button_style", "label": "Knaptype", "options": [
        { "value": "primary", "label": "Primær" }, { "value": "secondary", "label": "Sekundær" }
      ], "default": "primary" },
      { "type": "text", "id": "details_label", "label": "Linktekst til detaljer" },
      { "type": "url", "id": "details_link", "label": "Link til detaljer" }
    ] }
  ],
  "presets": [{ "name": "Forside: priser" }]
}
{% endschema %}
