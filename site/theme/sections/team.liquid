<section class="section section--{{ section.settings.scheme }} team" id="{{ section.settings.anchor | default: section.id | handle }}">
  <div class="container">
    {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text %}
    <ul class="team__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="person card" data-reveal {{ block.shopify_attributes }}>
          <div class="person__photo">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: block.settings.name }}
            {%- else -%}
              <span aria-hidden="true">{% render 'icon', name: 'user', size: 40 %}</span>
            {%- endif -%}
          </div>
          <h3 class="h5">{{ block.settings.name | escape }}</h3>
          <p class="person__role">{{ block.settings.role | escape }}</p>
          {%- if block.settings.bio != blank -%}<div class="rte small">{{ block.settings.bio }}</div>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Team",
  "tag": "div",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Farvetema", "options": [
      { "value": "light", "label": "Lyst" }, { "value": "surface", "label": "Lys flade" }, { "value": "dark", "label": "Mørkt" }
    ], "default": "surface" },
    { "type": "text", "id": "anchor", "label": "Anker-id", "default": "team" },
    { "type": "text", "id": "eyebrow", "label": "Lille overskrift", "default": "Holdet" },
    { "type": "inline_richtext", "id": "heading", "label": "Overskrift", "default": "Menneskene bag" },
    { "type": "richtext", "id": "text", "label": "Tekst" }
  ],
  "blocks": [
    { "type": "person", "name": "Person", "settings": [
      { "type": "image_picker", "id": "image", "label": "Foto" },
      { "type": "text", "id": "name", "label": "Navn", "default": "[NAVN]" },
      { "type": "text", "id": "role", "label": "Rolle", "default": "[ROLLE]" },
      { "type": "richtext", "id": "bio", "label": "Kort beskrivelse" }
    ] }
  ],
  "presets": [{ "name": "Team", "blocks": [{ "type": "person" }, { "type": "person" }] }]
}
{% endschema %}
