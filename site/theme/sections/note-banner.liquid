{%- comment -%} Kort besked i en ramme med op til to links. Bruges fx til fortrolighedsaftalen. {%- endcomment -%}
<section class="section section--tight note" id="{{ section.settings.anchor | default: section.id | handle }}">
  <div class="container">
    <div class="note__box">
      <div class="note__content">
        <h2 class="t-sm note__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
      </div>
      <div class="note__actions">
        {% render 'button', label: section.settings.primary_label, url: section.settings.primary_link, style: 'secondary' %}
        {%- if section.settings.secondary_label != blank -%}<a class="arrow-link" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kort besked",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker-id" },
    { "type": "inline_richtext", "id": "heading", "label": "Overskrift", "default": "Kort besked" },
    { "type": "richtext", "id": "text", "label": "Tekst" },
    { "type": "text", "id": "primary_label", "label": "Knaptekst" },
    { "type": "url", "id": "primary_link", "label": "Knaplink" },
    { "type": "text", "id": "secondary_label", "label": "Linktekst" },
    { "type": "url", "id": "secondary_link", "label": "Link" }
  ],
  "presets": [{ "name": "Kort besked" }]
}
{% endschema %}
