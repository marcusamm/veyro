{%- comment -%}
  Problem → løsning. Fungerer som faneblade (ARIA tabs) med JavaScript,
  og som en almindelig liste uden JavaScript.
{%- endcomment -%}
<section class="section section--{{ section.settings.scheme }} problems" id="{{ section.settings.anchor | default: section.id | handle }}">
  <div class="container">
    {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text %}

    <div class="problems__ui" data-tabs>
      <div class="problems__tabs" role="tablist" aria-label="{{ section.settings.heading | strip_html | escape }}">
        {%- for block in section.blocks -%}
          <button class="problems__tab" type="button" role="tab" id="Tab-{{ block.id }}" aria-controls="Panel-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" {% unless forloop.first %}tabindex="-1"{% endunless %} {{ block.shopify_attributes }}>
            <span class="problems__tab-index">{{ forloop.index }}</span>
            <span class="problems__tab-title">{{ block.settings.title | escape }}</span>
            {% render 'icon', name: 'arrow-right', size: 18, class: 'problems__tab-arrow' %}
          </button>
        {%- endfor -%}
      </div>

      <div class="problems__panels">
        {%- for block in section.blocks -%}
          <div class="problems__panel" role="tabpanel" id="Panel-{{ block.id }}" aria-labelledby="Tab-{{ block.id }}" tabindex="0">
            <div class="problems__problem">
              <p class="tag tag--muted">{{ section.settings.problem_label | escape }}</p>
              <h3 class="h3">{{ block.settings.title | escape }}</h3>
              <div class="rte">{{ block.settings.problem }}</div>
            </div>
            <div class="problems__solution">
              <p class="tag tag--accent">{% render 'icon', name: block.settings.icon, size: 16 %}{{ section.settings.solution_label | escape }}</p>
              <h4 class="h4">{{ block.settings.solution_title | escape }}</h4>
              <div class="rte">{{ block.settings.solution }}</div>
              {% render 'button', label: block.settings.link_label, url: block.settings.link, style: 'link' %}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Problemer og løsninger",
  "tag": "div",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Farvetema", "options": [
      { "value": "light", "label": "Lyst" }, { "value": "surface", "label": "Lys flade" }, { "value": "dark", "label": "Mørkt" }
    ], "default": "surface" },
    { "type": "text", "id": "anchor", "label": "Anker-id", "info": "Bruges til links som /#problemer", "default": "problemer" },
    { "type": "text", "id": "eyebrow", "label": "Lille overskrift", "default": "Kender du det?" },
    { "type": "inline_richtext", "id": "heading", "label": "Overskrift", "default": "Når hjemmesiden står i vejen for salget" },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>De fleste hjemmesider og webshops har et par flaskehalse, der koster kunder og tid. Vælg en udfordring, og se hvordan vi griber den an.</p>" },
    { "type": "text", "id": "problem_label", "label": "Mærkat: problem", "default": "Problemet" },
    { "type": "text", "id": "solution_label", "label": "Mærkat: løsning", "default": "Sådan hjælper vi" }
  ],
  "blocks": [
    {
      "type": "problem",
      "name": "Problem",
      "settings": [
        { "type": "text", "id": "title", "label": "Problem", "default": "Langsom indlæsning" },
        { "type": "richtext", "id": "problem", "label": "Beskrivelse af problemet", "default": "<p>Tunge billeder, mange apps og ubrugt kode får siderne til at hænge – især på mobilen.</p>" },
        { "type": "select", "id": "icon", "label": "Ikon", "options": [
          { "value": "speed", "label": "Hastighed" }, { "value": "conversion", "label": "Konvertering" }, { "value": "code", "label": "Kode" },
          { "value": "design", "label": "Design" }, { "value": "wrench", "label": "Værktøj" }, { "value": "integration", "label": "Integration" },
          { "value": "automation", "label": "Automatisering" }, { "value": "layers", "label": "Lag" }, { "value": "eye", "label": "Overblik" }
        ], "default": "speed" },
        { "type": "text", "id": "solution_title", "label": "Løsning – overskrift", "default": "Website-optimering" },
        { "type": "richtext", "id": "solution", "label": "Løsning – tekst", "default": "<p>Vi måler, hvor tiden går, og retter det, der gør den største forskel.</p>" },
        { "type": "text", "id": "link_label", "label": "Linktekst", "default": "Læs om ydelsen" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Problemer og løsninger", "blocks": [{ "type": "problem" }, { "type": "problem" }, { "type": "problem" }] }]
}
{% endschema %}
