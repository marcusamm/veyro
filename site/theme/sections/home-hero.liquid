<section class="home-hero">
  <div class="container">
    <div class="studio-stage">
      <div class="studio-art" aria-hidden="true">
        <canvas class="studio-particles" data-particle-scene></canvas>
      </div>
      <div class="studio-message">
        <p class="studio-label">Et lille digitalt bureau. Tæt på din forretning.</p>
        <h1 class="home-hero__title">{{ section.settings.heading }}</h1>
        <p class="studio-message__description">Hjemmeside, booking og webshop til mindre virksomheder. Vi designer, sætter op og hjælper jer videre i hverdagen.</p>
        <nav class="studio-specialties" aria-label="Vores løsninger"><a href="/pages/hjemmeside">Hjemmeside <span aria-hidden="true">↗</span></a><a href="/pages/booking">Booking <span aria-hidden="true">↗</span></a><a href="/pages/webshop">Webshop <span aria-hidden="true">↗</span></a></nav>
      </div>
      <div class="studio-action">
        <p class="studio-price"><span>Hjemmesider fra</span><strong>199 <small>kr./md.</small></strong><span>ekskl. moms</span></p>
        <div class="actions">
          {% render 'button', label: section.settings.primary_label, url: section.settings.primary_link, style: 'primary' %}
          {% render 'button', label: section.settings.secondary_label, url: section.settings.secondary_link, style: 'secondary' %}
        </div>
        <p class="home-hero__facts">Første måned gratis · Ingen binding</p>
      </div>
      <div class="studio-wordmark" aria-hidden="true">VEYRO</div>
      <a class="studio-scroll" href="#studio-introduction"><span>Scroll og se mere</span><span aria-hidden="true">↓</span></a>
    </div>
    <div class="studio-introduction" id="studio-introduction">
      <div class="studio-introduction__identity"><p class="studio-label">Din forretning.<br>Vores håndværk.</p>{% render 'brand-mark' %}<span>Et lille bureau.<br>En fast kontakt.</span></div>
      <div><h2>Du gør det, du er god til.<br><span>Vi tager os af hjemmesiden.</span></h2><div class="rte">{{ section.settings.text }}</div></div>
      <div class="studio-introduction__contact"><p>Lad os starte med jeres idé.</p><a href="mailto:{{ settings.company_email | escape }}">{{ settings.company_email | escape }}</a><a class="arrow-link" href="/pages/om-os">Mød Veyro</a></div>
      <ul class="studio-promises" role="list"><li><span aria-hidden="true">✳</span><div><strong>Design til jeres virksomhed</strong><p>Et udtryk, der tager afsæt i jer og det, kunderne skal kunne.</p></div></li><li><span aria-hidden="true">↗</span><div><strong>Teknikken er med</strong><p>Hosting, teknisk vedligeholdelse og hjælp til de små justeringer.</p></div></li><li><span aria-hidden="true">↔</span><div><strong>Vi finder formen sammen</strong><p>Tre korrekturrunder under opsætningen, så I kan give samlet feedback.</p></div></li></ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Forside: top",
  "tag": "div",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Overskrift (H1)", "default": "En hjemmeside, der passer til din forretning." },
    { "type": "richtext", "id": "text", "label": "Tekst" },
    { "type": "text", "id": "primary_label", "label": "Primær knap – tekst", "default": "Se priser" },
    { "type": "url", "id": "primary_link", "label": "Primær knap – link", "default": "/pages/priser" },
    { "type": "text", "id": "secondary_label", "label": "Sekundær knap – tekst", "default": "Se eksempler" },
    { "type": "url", "id": "secondary_link", "label": "Sekundær knap – link", "default": "/pages/eksempler" },
    { "type": "text", "id": "facts", "label": "Kort linje under knapperne" },
    { "type": "select", "id": "concept", "label": "Designkoncept", "options": [
      { "value": "craft", "label": "Hjemmeside (tømrer)" }, { "value": "salon", "label": "Booking (frisør)" }, { "value": "shop", "label": "Webshop (keramik)" }
    ], "default": "craft" },
    { "type": "text", "id": "caption", "label": "Tekst under konceptet", "default": "Forsiden hos Holm Tømrer. Udsnittet viser, hvordan pakken Hjemmeside kan se ud." }
  ]
}
{% endschema %}
