{%- comment -%}
  Brugere i Booking og Webshop: 3 er inkluderet, og hver ekstra bruger koster et fast beløb pr. måned.
  Tabellen regnes ud fra indstillingerne: pris + (antal − inkluderede) × ekstrapris.
{%- endcomment -%}
{%- liquid
  assign inc = section.settings.included
  assign extra = section.settings.extra_price
  assign max = inc | plus: 3
-%}
<section class="section staff staff--tiers" id="{{ section.settings.anchor | default: section.id | handle }}">
  <div class="container staff__inner">
    <div class="staff__text">
      {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text %}
    </div>
    <div class="staff__table-wrap">
      <div class="pricing-table-scroll" role="region" aria-label="{{ 'webshop_tiers.staff_table' | t | escape }}" tabindex="0">
      <table class="table staff__table">
        <caption>{{ section.settings.caption | escape }}</caption>
        <thead>
          <tr>
            <th scope="col">{{ 'public.users' | t }}</th>
            {%- if section.settings.a_label != blank -%}<th scope="col" class="num">{{ section.settings.a_label | escape }}</th>{%- endif -%}
            {%- for tier in webshop_tiers -%}<th scope="col" class="num">{{ 'webshop_tiers.tier_name' | t: capacity: tier.capacity }}</th>{%- endfor -%}
          </tr>
        </thead>
        <tbody>
          {%- for n in (inc..max) -%}
            {%- assign add = n | minus: inc | times: extra -%}
            {%- assign a = section.settings.a_price | plus: add -%}
            <tr><th scope="row">{{ n }}{% if n == inc %} {{ 'public.included_parentheses' | t }}{% endif %}</th>
              {%- if section.settings.a_label != blank -%}<td class="num">{{ a | display_money }}</td>{%- endif -%}
              {%- for tier in webshop_tiers -%}{%- assign tier_total = tier.price_dkk | plus: add -%}<td class="num">{{ tier_total | display_money }}</td>{%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
      </div>
      <p class="staff__note">{{ 'webshop_tiers.staff_capacity_note' | t }}</p>
      <p class="pricing-table-hint">{{ 'webshop_tiers.scroll_hint' | t }}</p>
      {% render 'currency-note' %}
      {%- if section.settings.table_note != blank -%}<p class="staff__note">{{ section.settings.table_note | escape }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brugere og pris",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker-id", "default": "brugere" },
    { "type": "text", "id": "eyebrow", "label": "Lille overskrift" },
    { "type": "inline_richtext", "id": "heading", "label": "Overskrift", "default": "Brugere i Booking og Webshop" },
    { "type": "richtext", "id": "text", "label": "Tekst" },
    { "type": "text", "id": "caption", "label": "Tabeltitel", "default": "Samlet månedspris ekskl. moms efter antal brugere" },
    { "type": "number", "id": "included", "label": "Brugere inkluderet", "default": 3 },
    { "type": "number", "id": "extra_price", "label": "Pris pr. ekstra bruger (kr./md.)", "default": 99 },
    { "type": "text", "id": "a_label", "label": "Kolonne 1 – pakke", "default": "Booking" },
    { "type": "number", "id": "a_price", "label": "Kolonne 1 – grundpris", "default": 299 },
    { "type": "text", "id": "b_label", "label": "Kolonne 2 – pakke", "default": "Webshop" },
    { "type": "number", "id": "b_price", "label": "Kolonne 2 – grundpris", "default": 499 },
    { "type": "text", "id": "table_note", "label": "Note under tabellen" }
  ],
  "presets": [{ "name": "Brugere og pris" }]
}
{% endschema %}
