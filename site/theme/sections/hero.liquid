{%- liquid
  assign primary_url = section.settings.primary_link | default: pages['kontakt'].url | default: '/pages/kontakt'
  assign secondary_url = section.settings.secondary_link | default: pages['ydelser'].url | default: '/pages/ydelser'
-%}
<section class="hero section section--{{ section.settings.scheme }}{% if section.settings.visual == 'none' %} hero--text-only{% endif %}" aria-labelledby="HeroTitle-{{ section.id }}">
  <div class="hero__grid-bg" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow eyebrow--pill" data-reveal>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="hero__title h-display" id="HeroTitle-{{ section.id }}" data-reveal>{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="hero__text lead" data-reveal>{{ section.settings.text }}</div>
      {%- endif -%}
      <div class="hero__actions" data-reveal>
        {% render 'button', label: section.settings.primary_label, url: primary_url, style: 'primary', arrow: settings.button_arrow %}
        {% render 'button', label: section.settings.secondary_label, url: secondary_url, style: 'secondary' %}
      </div>
      {%- if section.blocks.size > 0 -%}
        <ul class="hero__points" role="list" data-reveal>
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{% render 'icon', name: 'check', size: 18 %}<span>{{ block.settings.text | escape }}</span></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- unless section.settings.visual == 'none' -%}
    <div class="hero__visual" data-reveal>
      {%- if section.settings.visual == 'image' and section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            class: 'hero__image',
            widths: '480, 720, 960, 1200, 1400',
            sizes: '(min-width: 990px) 50vw, 100vw',
            loading: 'eager',
            fetchpriority: 'high'
        }}
      {%- elsif section.settings.visual == 'orders' -%}
        {% render 'ops-visual' %}
      {%- else -%}
        {% render 'hero-visual' %}
      {%- endif -%}
    </div>
    {%- endunless -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "class": "section-hero",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Farvetema", "options": [
      { "value": "light", "label": "Lyst" }, { "value": "surface", "label": "Lys flade" }, { "value": "dark", "label": "Mørkt" }
    ], "default": "light" },
    { "type": "text", "id": "eyebrow", "label": "Lille overskrift", "default": "Alle platforme" },
    { "type": "inline_richtext", "id": "heading", "label": "Overskrift", "info": "Markér ord med kursiv for at fremhæve dem.", "default": "Vi optimerer din hjemmeside eller webshop, så den <em>arbejder bedre</em> for din forretning." },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Fra hurtigere indlæsning og bedre konverteringer til skræddersyede løsninger. Vi hjælper dig med at få mere ud af din webshop.</p>" },
    { "type": "text", "id": "primary_label", "label": "Primær knap", "default": "Få en gratis vurdering" },
    { "type": "url", "id": "primary_link", "label": "Primært link" },
    { "type": "text", "id": "secondary_label", "label": "Sekundær knap", "default": "Se vores ydelser" },
    { "type": "url", "id": "secondary_link", "label": "Sekundært link" },
    { "type": "select", "id": "visual", "label": "Visuelt element", "options": [
      { "value": "none", "label": "Intet (kun tekst)" },
      { "value": "image", "label": "Eget billede" },
      { "value": "dashboard", "label": "Indbygget illustration" },
      { "value": "orders", "label": "Eksempel: ordre- og lagersystem" }
    ], "default": "none" },
    { "type": "image_picker", "id": "image", "label": "Billede" }
  ],
  "blocks": [
    { "type": "point", "name": "Fordel", "limit": 4, "settings": [
      { "type": "text", "id": "text", "label": "Tekst", "default": "Gratis og uforpligtende første vurdering" }
    ] }
  ],
  "presets": [{ "name": "Hero", "blocks": [{ "type": "point" }] }]
}
{% endschema %}
