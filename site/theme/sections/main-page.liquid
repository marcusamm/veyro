{%- comment -%}
  Sidens eget indhold fra Admin › Hjemmeside › Sider. Bruges til vilkår, politikker og aftaler.
  Teksten vises uændret. Versionslinjen (første afsnit i kursiv, fx "Version 2026-10-21 · …") vises
  øverst ved titlen. Lange dokumenter får en indholdsfortegnelse, bygget af afsnittenes <h2>.
{%- endcomment -%}
{%- liquid
  assign parts = page.content | split: '<h2>'
  assign source_parts = page.original_content | default: page.content | split: '<h2>'
  assign intro = parts[0]
  assign version = ''
  assign intro_start = intro | strip | slice: 0, 7
  if intro_start == '<p><em>'
    assign version = intro | split: '</em>' | first | split: '<em>' | last | strip
    assign version_p = intro | split: '</p>' | first | append: '</p>'
    assign intro = intro | remove_first: version_p
  endif
  assign count = parts.size | minus: 1
  assign show_toc = false
  if section.settings.toc and count >= section.settings.toc_min
    assign show_toc = true
  endif
-%}
<section class="section doc{% if show_toc %} doc--toc{% endif %}">
  <div class="container">
    <header class="doc__head">
      <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
        <ol role="list">
          <li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
          <li><span aria-current="page">{{ page.title | escape }}</span></li>
        </ol>
      </nav>
      <h1 class="t-lg doc__title">{{ page.title | escape }}</h1>
      {%- if version != blank -%}<p class="doc__version">{{ version }}</p>{%- endif -%}
    </header>

    <div class="doc__grid">
      {%- if show_toc -%}
        <nav class="doc__toc" aria-labelledby="Toc-{{ section.id }}">
          <details class="doc__toc-box" open data-toc>
            <summary id="Toc-{{ section.id }}">{{ 'public.contents' | t }}</summary>
            <ol role="list">
              {%- for part in parts offset: 1 -%}
                {%- assign heading = part | split: '</h2>' | first | strip_html | strip -%}
                {%- assign source_heading = source_parts[forloop.index] | split: '</h2>' | first | strip_html | strip -%}
                <li><a href="#{{ source_heading | handle }}">{{ heading }}</a></li>
              {%- endfor -%}
            </ol>
          </details>
        </nav>
      {%- endif -%}
      <div class="rte rte--long doc__body">
        {{ intro }}
        {%- for part in parts offset: 1 -%}
          {%- assign source_heading = source_parts[forloop.index] | split: '</h2>' | first | strip_html | strip -%}
          <h2 id="{{ source_heading | handle }}">{{ part }}
        {%- endfor -%}
      </div>
    </div>

    {%- assign related = section.settings.related_menu -%}
    {%- if related.links.size > 0 -%}
      <nav class="doc__related" aria-labelledby="Related-{{ section.id }}">
        <h2 class="doc__related-title" id="Related-{{ section.id }}">{{ section.settings.related_heading | escape }}</h2>
        <ul role="list">
          {%- for link in related.links -%}
            {%- unless link.current -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endunless -%}
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Sideindhold",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "toc", "label": "Vis indholdsfortegnelse", "default": true },
    { "type": "number", "id": "toc_min", "label": "Mindste antal afsnit for indholdsfortegnelse", "default": 5 },
    { "type": "link_list", "id": "related_menu", "label": "Andre dokumenter", "default": "juridisk" },
    { "type": "text", "id": "related_heading", "label": "Overskrift over andre dokumenter", "default": "Andre dokumenter" }
  ]
}
{% endschema %}
