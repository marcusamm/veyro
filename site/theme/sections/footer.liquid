{%- comment -%}
  Kompakt sidefod: kort beskrivelse, tre menuer, kontakt- og virksomhedsoplysninger
  (redigeres under Temaindstillinger › Virksomhed) og cookieindstillinger.
{%- endcomment -%}
{%- liquid
  assign company = settings.company_name | default: shop.name
  assign footer_nav_label = 'general.footer_navigation' | t
  assign footer_contact_label = 'footer.contact' | t
  assign current_year = 'now' | date: '%Y'
-%}
<footer class="site-footer">
  <div class="container">
    <div class="footer-invitation">
      <p>Et lille bureau.<br><em>En fast kontakt.</em></p>
      <a class="arrow-link" href="/pages/kontakt">Lad os tale om jeres virksomhed</a>
    </div>
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a class="logo logo--footer" href="{{ routes.root_url }}" aria-label="{{ company | escape }} – {{ 'general.home' | t }}">
          {%- render 'brand-mark' -%}
          <span class="logo__wordmark"><span class="logo__text">{{ company | escape }}</span><span class="logo__dot" aria-hidden="true">.</span></span>
        </a>
        {%- if section.settings.text != blank -%}
          <p class="site-footer__tagline">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            {%- if block.settings.menu.links.size > 0 -%}
              <nav class="site-footer__col" aria-label="{{ block.settings.heading | default: footer_nav_label | escape }}" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}<h2 class="site-footer__heading">{{ block.settings.heading | escape }}</h2>{%- endif -%}
                <ul role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              </nav>
            {%- endif -%}
          {%- when 'contact' -%}
            <div class="site-footer__col site-footer__contact" {{ block.shopify_attributes }}>
              <h2 class="site-footer__heading">{{ block.settings.heading | default: footer_contact_label | escape }}</h2>
              <ul role="list">
                {%- if settings.company_email != blank -%}<li><a href="mailto:{{ settings.company_email | escape }}">{{ settings.company_email | escape }}</a></li>{%- endif -%}
                {%- if settings.company_phone != blank -%}<li><a href="tel:{{ settings.company_phone | remove: ' ' | escape }}">{{ settings.company_phone | escape }}</a></li>{%- endif -%}
                {%- if settings.company_hours != blank -%}<li>{{ settings.company_hours | escape }}</li>{%- endif -%}
              </ul>
              <address class="site-footer__address">
                {{ company | escape }}<br>
                {%- if settings.company_address != blank -%}{{ settings.company_address | escape }}<br>{%- endif -%}
                {%- if settings.company_cvr != blank -%}{{ 'footer.cvr' | t }}: {{ settings.company_cvr | escape }}{%- endif -%}
              </address>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="site-footer__bottom">
      <p>{{ 'footer.copyright' | t: year: current_year, name: company }}</p>
      <ul class="site-footer__meta" role="list">
        {%- if settings.cookie_banner_enabled -%}
          <li><button type="button" class="link-button" data-cookie-open>{{ 'footer.cookie_settings' | t }}</button></li>
        {%- endif -%}
        {%- if section.settings.login_label != blank -%}
          <li><a href="{{ section.settings.login_link | default: 'https://kunde.veyro.dk/login' }}">{{ section.settings.login_label | escape }}</a></li>
        {%- endif -%}
        {%- assign socials = 'linkedin,instagram,facebook,github' | split: ',' -%}
        {%- for s in socials -%}
          {%- assign key = 'social_' | append: s -%}
          {%- if settings[key] != blank -%}
            <li><a href="{{ settings[key] | escape }}" target="_blank" rel="noopener">{{ s | capitalize }}<span class="visually-hidden"> ({{ 'general.new_window' | t }})</span></a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "text", "id": "text", "label": "Kort tekst under logoet", "default": "Hjemmesider, booking og webshops til mindre virksomheder. Vi sætter det op og holder det ved lige." },
    { "type": "text", "id": "login_label", "label": "Tekst for kundelogin", "default": "Kundelogin" },
    { "type": "url", "id": "login_link", "label": "Link til kundelogin", "info": "Tomt felt linker til https://kunde.veyro.dk/login." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Overskrift", "default": "Navigation" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "contact",
      "name": "Kontakt og virksomhed",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Overskrift", "default": "Kontakt" },
        { "type": "paragraph", "content": "E-mail, telefon, adresse og CVR redigeres under Temaindstillinger › Virksomhed." }
      ]
    }
  ]
}
{% endschema %}
