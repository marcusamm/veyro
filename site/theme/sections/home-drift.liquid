{%- comment -%}
  Drift og Alt inkl. – tydeligt markeret "På vej". To funktioner fremhæves med uddrag af et
  demo-panel (fiktive data); resten står i en kompakt liste. Lagerforklaringerne står ved demoen:
  ved kolonnerne, ved den markerede vare og ved handlingen. Ingen tooltips: alt er synlig tekst,
  og på mobil står forklaringerne under eksemplet.
  "Registrér forbrug" (theme.js › initDemo) ændrer kun tallene her på siden. Intet gemmes eller sendes.
  Disponibel = fysisk − reserveret.
{%- endcomment -%}
{%- assign rules = section.settings.rules | newline_to_br | split: '<br />' -%}
{%- assign more = section.settings.list | newline_to_br | split: '<br />' -%}
<section class="hd" id="{{ section.settings.anchor | default: section.id | handle }}">
  <div class="container">
    <header class="hd__head">
      <p class="hd__status"><span class="pc__badge">{{ section.settings.badge | escape }}</span>{{ section.settings.status_text | escape }}</p>
      <h2 class="h-big">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="hd__lead">{{ section.settings.text }}</div>{%- endif -%}
      {% render 'button', label: section.settings.cta_label, url: section.settings.cta_link, style: 'secondary' %}
    </header>

    <div class="hd__feature hd__feature--stock">
      <div class="hd__copy">
        <h3 class="hd__title">{{ section.settings.f1_title | escape }}</h3>
        <div class="hd__text">{{ section.settings.f1_text }}</div>
      </div>
      <figure class="demo__figure hd__demo">
        <div class="hd-panel">
          <div class="hd-panel__bar"><span>Lagerstatus</span><span class="ex-bar__tag">{{ section.settings.demo_badge | escape }}</span></div>
          <table class="hd-table">
            <caption class="visually-hidden">Eksempel på lagerstatus med fiktive varer</caption>
            <thead>
              <tr>
                <th scope="col">Vare</th>
                <th scope="col" class="num">Fysisk<small class="hd-note">på lageret</small></th>
                <th scope="col" class="num">Reserveret<small class="hd-note">på bekræftede ordrer</small></th>
                <th scope="col" class="num">Disponibel<small class="hd-note">kan bruges</small></th>
              </tr>
            </thead>
            <tbody>
              <tr data-demo-row><td>Arbejdshandsker, str. L<small>VN-1001</small></td><td class="num"><span data-demo-physical>120</span></td><td class="num"><span data-demo-reserved>24</span></td><td class="num"><b data-demo-available>96</b></td></tr>
              <tr><td>Skruer 4×40, 200 stk.<small>VN-1022</small></td><td class="num">64</td><td class="num">8</td><td class="num"><b>56</b></td></tr>
              <tr class="is-low"><td>Malertape 25 mm<small>VN-1014</small><small class="hd-note hd-note--low">Lav beholdning: under minimum på 10</small></td><td class="num">18</td><td class="num">12</td><td class="num"><b>6</b><span class="pill pill--low">Lav</span></td></tr>
            </tbody>
          </table>
          <div class="hd-action">
            <div class="hd-action__text">
              <p class="hd-action__what">Job #214: 3 par arbejdshandsker brugt</p>
              <p class="hd-note hd-note--action">Registreret forbrug trækker fra fysisk og disponibel. Reserveret er uændret.</p>
            </div>
            <div class="hd-action__try" data-demo-try data-qty="3" hidden>
              <button type="button" class="btn btn--primary btn--sm" data-demo-play data-label-reset="Nulstil eksempel">Registrér forbrug</button>
              <p class="hd-action__status" role="status" data-demo-status></p>
            </div>
          </div>
        </div>
        <figcaption class="visually-hidden">Eksempel – Drift er på vej. Tallene er fiktive.</figcaption>
      </figure>
      <ul class="hd-legend" role="list">
        <li class="hd-legend__m"><strong>Fysisk</strong> er det, der står på lageret.</li>
        <li class="hd-legend__m"><strong>Reserveret</strong> er varer på bekræftede ordrer.</li>
        <li class="hd-legend__m"><strong>Disponibel</strong> er fysisk minus reserveret: det, der reelt kan bruges eller sælges.</li>
        <li class="hd-legend__m"><strong>Lav beholdning</strong> markeres, når en vare kommer under sit minimum.</li>
        <li class="hd-legend__m"><strong>Registreret forbrug</strong> på et job trækker fra fysisk og disponibel.</li>
        {%- for r in rules -%}
          {%- assign line = r | strip -%}
          {%- if line != blank -%}{%- assign parts = line | split: '|' -%}
            <li><strong>{{ parts[0] | strip | escape }}.</strong> {{ parts[1] | strip | escape }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    <div class="hd__feature hd__feature--jobs">
      <figure class="hd__demo">
        <div class="hd-panel">
          <div class="hd-panel__bar"><span>Jobs og ordrer</span><span class="ex-bar__tag">{{ section.settings.demo_badge | escape }}</span></div>
          <ul class="hd-tabs" role="list" aria-hidden="true"><li class="is-on">Alle 4</li><li>Jobs 2</li><li>Ordrer 2</li></ul>
          <table class="hd-table hd-table--jobs">
            <caption class="visually-hidden">Eksempel på jobs og ordrer med fiktive kunder</caption>
            <thead><tr><th scope="col">Nr.</th><th scope="col">Kunde</th><th scope="col">Kilde</th><th scope="col">Status</th></tr></thead>
            <tbody>
              <tr><td>Job #214</td><td>K. Holm<small>Badeværelse · 3 materialer</small></td><td>Telefon</td><td><span class="pill pill--busy">I gang</span></td></tr>
              <tr><td>Ordre #1048</td><td>M. Larsen<small>3 varer</small></td><td>Hjemmeside</td><td><span class="pill pill--new">Ny</span></td></tr>
              <tr><td>Ordre #1047</td><td>J. Holm<small>5 varer</small></td><td>E-mail</td><td><span class="pill pill--new">Ny</span></td></tr>
              <tr><td>Job #213</td><td>S. Nielsen<small>Køkken · 7 materialer</small></td><td>Direkte</td><td><span class="pill pill--done">Afsluttet</span></td></tr>
            </tbody>
          </table>
        </div>
      </figure>
      <div class="hd__copy">
        <h3 class="hd__title">{{ section.settings.f2_title | escape }}</h3>
        <div class="hd__text">{{ section.settings.f2_text }}</div>
      </div>
    </div>

    <div class="hd__bottom">
      <div class="hd__more">
        {%- if section.settings.list_heading != blank -%}<h3 class="hd__more-title">{{ section.settings.list_heading | escape }}</h3>{%- endif -%}
        <ul class="hd__more-list" role="list">
          {%- for m in more -%}{%- assign line = m | strip -%}{%- if line != blank -%}<li>{{ line | escape }}</li>{%- endif -%}{%- endfor -%}
        </ul>
      </div>
      {%- if section.blocks.size > 0 -%}
        <ul class="pc-grid pc-grid--coming" role="list">
          {%- for block in section.blocks -%}{% render 'price-card', block: block, frame: false %}{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    {%- if section.settings.note != blank -%}<div class="hd__note">{{ section.settings.note }}</div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Forside: Drift (på vej)",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker-id", "default": "drift" },
    { "type": "text", "id": "badge", "label": "Mærkat", "default": "På vej" },
    { "type": "text", "id": "status_text", "label": "Tekst ved mærkat", "default": "Under udvikling" },
    { "type": "inline_richtext", "id": "heading", "label": "Overskrift", "default": "Drift: jobs, ordrer og lager samlet" },
    { "type": "richtext", "id": "text", "label": "Tekst" },
    { "type": "text", "id": "cta_label", "label": "Knaptekst", "default": "Bliv testkunde" },
    { "type": "url", "id": "cta_link", "label": "Knaplink" },
    { "type": "text", "id": "demo_badge", "label": "Mærkat på demoen", "default": "Eksempel · fiktive data" },
    { "type": "text", "id": "f1_title", "label": "Funktion 1 – titel", "default": "Automatisk lageropdatering ved registreret forbrug" },
    { "type": "richtext", "id": "f1_text", "label": "Funktion 1 – tekst" },
    { "type": "textarea", "id": "rules", "label": "Lagerregler (én pr. linje: Titel | Forklaring)" },
    { "type": "text", "id": "f2_title", "label": "Funktion 2 – titel", "default": "Overblik over jobs og ordrer" },
    { "type": "richtext", "id": "f2_text", "label": "Funktion 2 – tekst" },
    { "type": "text", "id": "list_heading", "label": "Overskrift over øvrige funktioner" },
    { "type": "textarea", "id": "list", "label": "Øvrige funktioner (én pr. linje)" },
    { "type": "richtext", "id": "note", "label": "Note" }
  ],
  "blocks": [
    { "type": "package", "name": "Pakke", "limit": 3, "settings": [
      { "type": "text", "id": "title", "label": "Navn", "default": "Drift" },
      { "type": "select", "id": "status", "label": "Status", "options": [
        { "value": "available", "label": "Kan bestilles nu" }, { "value": "quote", "label": "Efter tilbud" }, { "value": "coming", "label": "På vej" }
      ], "default": "coming" },
      { "type": "text", "id": "badge", "label": "Mærkat", "default": "På vej" },
      { "type": "text", "id": "text", "label": "Kort beskrivelse" },
      { "type": "text", "id": "price_label", "label": "Tekst over prisen", "default": "Forventet pris" },
      { "type": "text", "id": "price", "label": "Pris", "default": "599 kr." },
      { "type": "text", "id": "interval", "label": "Interval", "default": "/md." },
      { "type": "text", "id": "vat", "label": "Momsnote", "default": "ekskl. moms" },
      { "type": "textarea", "id": "features", "label": "Indhold (én pr. linje)" },
      { "type": "text", "id": "button_label", "label": "Knaptekst", "default": "Bliv testkunde" },
      { "type": "url", "id": "button_link", "label": "Knaplink" },
      { "type": "select", "id": "button_style", "label": "Knaptype", "options": [
        { "value": "primary", "label": "Primær" }, { "value": "secondary", "label": "Sekundær" }
      ], "default": "secondary" },
      { "type": "text", "id": "details_label", "label": "Linktekst til detaljer" },
      { "type": "url", "id": "details_link", "label": "Link til detaljer" }
    ] }
  ],
  "presets": [{ "name": "Forside: Drift (på vej)" }]
}
{% endschema %}
