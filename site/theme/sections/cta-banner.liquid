{%- comment -%} Afslutning på en side: kort overskrift, én knap og direkte kontakt. {%- endcomment -%}
{%- liquid
  assign cta_url = section.settings.link | default: pages['kontakt'].url | default: '/pages/kontakt'
-%}
<section class="section cta" id="{{ section.settings.anchor | default: section.id | handle }}">
  <div class="container">
    <div class="cta__box">
      <div class="cta__content">
        <h2 class="t-lg cta__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
      </div>
      <div class="cta__actions">
        {% render 'button', label: section.settings.label, url: cta_url, style: 'primary' %}
        {% render 'button', label: section.settings.secondary_label, url: section.settings.secondary_link, style: 'secondary' %}
        {%- if section.settings.show_email and settings.company_email != blank -%}
          <p class="cta__alt">{{ section.settings.email_prefix | escape }} <a href="mailto:{{ settings.company_email | escape }}">{{ settings.company_email | escape }}</a>{% if settings.company_phone != blank %} eller ring på <a href="tel:{{ settings.company_phone | remove: ' ' | escape }}">{{ settings.company_phone | escape }}</a>{% endif %}.</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Afslutning med knap",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker-id", "default": "kom-i-gang" },
    { "type": "inline_richtext", "id": "heading", "label": "Overskrift", "default": "Vil du se, hvordan det kan se ud hos jer?" },
    { "type": "richtext", "id": "text", "label": "Tekst" },
    { "type": "text", "id": "label", "label": "Knaptekst", "default": "Aftal en demo" },
    { "type": "url", "id": "link", "label": "Knaplink" },
    { "type": "text", "id": "secondary_label", "label": "Sekundær knap – tekst" },
    { "type": "url", "id": "secondary_link", "label": "Sekundær knap – link" },
    { "type": "checkbox", "id": "show_email", "label": "Vis e-mail og telefon som alternativ", "default": true },
    { "type": "text", "id": "email_prefix", "label": "Tekst før e-mail", "default": "Eller skriv til" }
  ],
  "presets": [{ "name": "Afslutning med knap" }]
}
{% endschema %}
