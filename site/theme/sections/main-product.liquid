{%- comment -%}
  Abonnementsside. „Læg i kurv“ lægger abonnementet i kurven, som sendes som en forespørgsel.
  Der betales aldrig på hjemmesiden.
{%- endcomment -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign kontakt = pages['kontakt'].url | default: '/pages/kontakt'
  comment
    Abonnementer betales ikke her: kurven sendes som en forespørgsel, og Veyro sender tilbud og faktura.
  endcomment
  assign is_subscription = false
  if product.type == section.settings.subscription_type
    assign is_subscription = true
  endif
  assign can_buy = current_variant.available
  assign quote_url = kontakt | append: '#formular'
  if is_subscription
    assign quote_url = kontakt | append: '?ydelse=abonnement-' | append: product.handle | append: '#formular'
  endif
-%}
<section class="section product{% unless product.featured_media %} product--no-media{% endunless %}">
  <div class="container product__inner">
    {%- if product.featured_media -%}
      <div class="product__media">
        {{ product.featured_media | image_url: width: 1400 | image_tag: widths: '500, 800, 1100, 1400', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'eager', fetchpriority: 'high', class: 'product__image' }}
      </div>
    {%- endif -%}

    <div class="product__info">
      <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
        <ol role="list">
          <li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
          {%- if collection -%}<li><a href="{{ collection.url }}">{{ collection.title | escape }}</a></li>{%- endif -%}
          <li><span aria-current="page">{{ product.title | escape }}</span></li>
        </ol>
      </nav>
      {%- if product.type != blank -%}<p class="eyebrow">{{ product.type | escape }}</p>{%- endif -%}
      <h1 class="h1">{{ product.title | escape }}</h1>

      <div class="product__price" data-price>
        <span class="visually-hidden">{{ 'products.price' | t }}</span>
        <span class="product__price-current">{{ current_variant.price | money_without_trailing_zeros }}</span>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <s class="muted"><span class="visually-hidden">{{ 'products.regular_price' | t }}</span>{{ current_variant.compare_at_price | money }}</s>
        {%- endif -%}
        {%- if is_subscription -%}<span class="product__per">{{ 'subscriptions.per_month' | t }}</span>{%- endif -%}
        {%- if cart.taxes_included -%}<span class="small muted">{{ 'products.tax_included' | t }}</span>{%- endif -%}
      </div>
      {%- if is_subscription -%}
        <p class="sub-terms">{% render 'icon', name: 'automation', size: 16 %}<span>{{ 'subscriptions.terms' | t }}</span></p>
      {%- endif -%}

      {%- if can_buy -%}
      {%- form 'product', product, id: 'ProductForm', class: 'product__form' -%}
        {%- unless product.has_only_default_variant -%}
          <div class="field">
            <label for="ProductVariant">{{ 'products.options' | t }}</label>
            <div class="select">
              <select id="ProductVariant" name="id" data-variant-select>
                {%- for variant in product.variants -%}
                  <option value="{{ variant.id }}" data-price="{{ variant.price | money | escape }}"{% if variant == current_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>
                    {{ variant.title | escape }}{% unless variant.available %} – {{ 'products.sold_out' | t }}{% endunless %}
                  </option>
                {%- endfor -%}
              </select>
              {% render 'icon', name: 'arrow-down', size: 18 %}
            </div>
          </div>
        {%- else -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {%- endunless -%}

        <div class="product__buttons">
          <button type="submit" name="add" class="btn btn--{% if is_subscription %}primary{% else %}secondary{% endif %} btn--block"{% unless current_variant.available %} disabled{% endunless %}>
            {%- if current_variant.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
          </button>
        </div>
      {%- endform -%}
      {%- if is_subscription -%}<p class="small muted product__no-payment">{{ 'subscriptions.no_payment' | t }}</p>{%- endif -%}
      {%- endif -%}

      <div class="product__quote">
        {%- if can_buy -%}
          <a class="btn btn--link" href="{{ quote_url }}"><span>{{ 'subscriptions.get_quote' | t }}</span><span class="btn__icon">{% render 'icon', name: 'arrow-right', size: 18 %}</span></a>
        {%- else -%}
          <a class="btn btn--primary btn--block" href="{{ quote_url }}"><span>{{ 'subscriptions.get_quote' | t }}</span><span class="btn__icon">{% render 'icon', name: 'arrow-right', size: 18 %}</span></a>
        {%- endif -%}
        <p class="small muted">{{ 'subscriptions.quote_text' | t }}</p>
      </div>

      <div class="rte product__description">{{ product.description }}</div>

      {%- if section.settings.note != blank -%}
        <div class="product__note">{% render 'icon', name: 'chat', size: 20 %}<div class="rte small">{{ section.settings.note }}</div></div>
      {%- endif -%}
    </div>
  </div>
</section>

{%- capture product_schema -%}
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | json }},
  "url": {{ request.origin | append: product.url | json }},
  {%- if product.featured_image -%}"image": {{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }},{%- endif -%}
  "offers": {
    "@type": "Offer",
    "price": {{ current_variant.price | divided_by: 100.0 | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "availability": "https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}"
  }
}
{%- endcapture -%}
<script type="application/ld+json">{{ product_schema }}</script>

{% schema %}
{
  "name": "Produkt / pakke",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "subscription_type", "label": "Produkttype for abonnementer", "info": "Produkter med denne type vises som månedlige abonnementer. Kurven sendes som en forespørgsel uden betaling.", "default": "Abonnement" },
    { "type": "richtext", "id": "note", "label": "Note under beskrivelsen", "default": "<p>I tvivl om abonnementet passer til jer? <a href=\"/pages/kontakt\">Skriv til os</a>, før I sender forespørgslen. Der betales ikke her.</p>" }
  ]
}
{% endschema %}
