{%- comment -%}Skærmbillede fra den aktuelle Salon Nord-demo. Linket åbner det fiktive bookingforløb.{%- endcomment -%}
<section class="section booking-flow" id="{{ section.settings.anchor | default: 'fra-booking-til-overblik' | handle }}">
  <div class="container booking-flow__inner">
    <div class="booking-flow__copy">
      <p class="studio-label">{{ section.settings.eyebrow | escape }}</p>
      <h2 class="t-lg">{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      <ol class="booking-flow__steps" role="list">
        <li><span>01</span><div><strong>Kunden vælger selv en tid</strong><p>Jeres ydelser og ledige tider er samlet på hjemmesiden.</p></div></li>
        <li><span>02</span><div><strong>Bookingen er på plads</strong><p>I og kunden får en bekræftelse på mail. Kunden kan selv flytte eller aflyse.</p></div></li>
      </ol>
      <a class="arrow-link" href="/pages/booking">Se hvad Booking indeholder</a>
      <div class="booking-flow__details"><p>Fra første klik til dagens overblik</p><div><span>Ydelser og ledige tider</span><span>Bekræftelse på mail</span><span>Flytning og aflysning</span></div></div>
    </div>
    <figure class="booking-flow__figure">
      <a class="demo-snapshot" href="/demo/salon-nord/book?behandling=dameklip" aria-label="Prøv bookingforløbet hos Salon Nord">
        <span class="capability-browser__chrome" aria-hidden="true"><span><i></i><i></i><i></i></span><span>Salon Nord · Bookingdemo</span><span>↗</span></span>
        <picture><source media="(max-width: 499px)" srcset="/demo/_previews/salon-nord-booking-mobil.jpg"><img src="/demo/_previews/salon-nord-booking-960.jpg" srcset="/demo/_previews/salon-nord-booking-960.jpg 960w, /demo/_previews/salon-nord-booking-1920.jpg 1920w" sizes="(min-width: 990px) 45vw, 90vw" width="960" height="600" loading="lazy" alt="Skærmbillede fra Salon Nords bookingforløb, hvor kunden vælger en ledig tid"></picture>
        <span class="demo-snapshot__action">Prøv hele bookingforløbet <span aria-hidden="true">↗</span></span>
      </a>
      <figcaption>Skærmbillede fra Salon Nords bookingdemo. Ingen tid bliver booket.</figcaption>
    </figure>
  </div>
</section>
{% schema %}
{
  "name": "Booking: fra valg til overblik",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker-id", "default": "fra-booking-til-overblik" },
    { "type": "text", "id": "eyebrow", "label": "Lille overskrift", "default": "Mere end et flot førstehåndsindtryk" },
    { "type": "inline_richtext", "id": "heading", "label": "Overskrift", "default": "En god hjemmeside arbejder også i hverdagen." },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>For en salon er det ikke kun et spørgsmål om at se godt ud. Det handler også om at gøre det nemt at booke en tid — uden endnu et telefonopkald.</p>" }
  ],
  "presets": [{ "name": "Booking: fra valg til overblik" }]
}
{% endschema %}
