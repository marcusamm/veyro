{%- comment -%}
  To kolonner, ca. 40/60: venstre en stor overskrift og intro (sticky på store skærme, under menuen),
  højre fordelene som en lodret liste med fine skillelinjer. Én kolonne og ikke sticky på mobil.
{%- endcomment -%}
<section class="hb" id="{{ section.settings.anchor | default: section.id | handle }}">
  <div class="container hb__grid">
    <div class="hb__intro">
      <h2 class="h-big">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="hb__text">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <ol class="hb__list" role="list">
      {%- for block in section.blocks -%}
        <li class="hb__item" {{ block.shopify_attributes }}>
          <span class="hb__num" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
          <div>
            <h3 class="hb__title">{{ block.settings.title | escape }}</h3>
            <div class="hb__body">{{ block.settings.text }}</div>
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Forside: fordele",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker-id", "default": "fordele" },
    { "type": "inline_richtext", "id": "heading", "label": "Overskrift", "default": "Vi sætter det op. Du passer din forretning." },
    { "type": "richtext", "id": "text", "label": "Intro" }
  ],
  "blocks": [
    { "type": "benefit", "name": "Fordel", "limit": 4, "settings": [
      { "type": "text", "id": "title", "label": "Titel", "default": "Fordel" },
      { "type": "richtext", "id": "text", "label": "Tekst" }
    ] }
  ],
  "presets": [{ "name": "Forside: fordele", "blocks": [{ "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" }] }]
}
{% endschema %}
