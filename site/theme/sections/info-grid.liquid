{%- comment -%}
  Overskrift og en række punkter med titel og tekst. Bruges til vilkår, fordele, områder og værdier.
  Visning: "rows" (titel til venstre, tekst til højre), "grid" (kolonner) eller "split" (overskrift ved siden af listen).
{%- endcomment -%}
<section class="section info info--{{ section.settings.layout }}{% if section.settings.tight %} section--tight{% endif %}" id="{{ section.settings.anchor | default: section.id | handle }}">
  <div class="container info__inner">
    <div class="info__head">
      {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text %}
      {%- if section.settings.button_label != blank -%}
        <div class="actions">{% render 'button', label: section.settings.button_label, url: section.settings.button_link, style: section.settings.button_style %}</div>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <ul class="info__list" role="list">
        {%- for block in section.blocks -%}
          {%- assign s = block.settings -%}
          <li class="info__item" {% if s.anchor != blank %}id="{{ s.anchor | handle }}" {% endif %}{{ block.shopify_attributes }}>
            <h3 class="info__title">{%- if s.tag != blank -%}<span class="info__tag">{{ s.tag | escape }}</span>{%- endif -%}{{ s.title | escape }}</h3>
            <div class="info__text rte">{{ s.text }}{%- if s.link_label != blank -%}<p><a class="arrow-link" href="{{ s.link }}">{{ s.link_label | escape }}</a></p>{%- endif -%}</div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if section.settings.note != blank -%}<div class="info__note rte">{{ section.settings.note }}</div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Punkter med tekst",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker-id" },
    { "type": "select", "id": "layout", "label": "Visning", "options": [
      { "value": "rows", "label": "Rækker" }, { "value": "grid", "label": "Kolonner" }, { "value": "split", "label": "Overskrift ved siden af" }
    ], "default": "rows" },
    { "type": "checkbox", "id": "tight", "label": "Mindre luft over og under", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Lille overskrift" },
    { "type": "inline_richtext", "id": "heading", "label": "Overskrift", "default": "Godt at vide" },
    { "type": "richtext", "id": "text", "label": "Tekst" },
    { "type": "text", "id": "button_label", "label": "Knap – tekst" },
    { "type": "url", "id": "button_link", "label": "Knap – link" },
    { "type": "select", "id": "button_style", "label": "Knaptype", "options": [
      { "value": "primary", "label": "Primær" }, { "value": "secondary", "label": "Sekundær" }
    ], "default": "secondary" },
    { "type": "richtext", "id": "note", "label": "Note under punkterne" }
  ],
  "blocks": [
    { "type": "item", "name": "Punkt", "settings": [
      { "type": "text", "id": "title", "label": "Titel", "default": "Punkt" },
      { "type": "text", "id": "tag", "label": "Lille mærke", "info": "Fx Kræver tilbud. Brug det sparsomt." },
      { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Tekst</p>" },
      { "type": "text", "id": "anchor", "label": "Anker-id" },
      { "type": "text", "id": "link_label", "label": "Link – tekst" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [{ "name": "Punkter med tekst", "blocks": [{ "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
