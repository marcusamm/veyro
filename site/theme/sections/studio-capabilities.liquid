{%- comment -%}Actual screenshots of the current fictional demos. Each preview opens its demo; screenshots contain no live controls.{%- endcomment -%}
<section class="section studio-capabilities" id="mere-end-en-forside" aria-labelledby="CapabilitiesTitle">
  <div class="container">
    <div class="studio-capabilities__head">
      <div><p class="studio-label">{{ 'public.it_needs_to_work' | t }}</p><h2 class="t-lg" id="CapabilitiesTitle">{{ 'public.more_than' | t }}<br>{{ 'public.good_looking_homepage' | t }}</h2></div>
      <p>{{ 'public.customer_next_step' | t }}</p>
    </div>
    <div class="studio-capabilities__grid">
      <article class="capability capability--website">
        <div class="capability__copy">
          <p class="capability__label"><span class="capability__glyph" aria-hidden="true">↗</span> {{ 'public.website' | t }}</p>
          <h3>{{ 'public.first_impression' | t }}<br>{{ 'public.to_next_step' | t }}</h3>
          <p>{{ 'public.services_look_contact' | t }}</p>
        </div>
        <figure class="capability__figure capability__figure--website">
          <div class="capability-devices">
            <a class="capability-browser" href="/demo/holm-tomrer/" aria-label="{{ 'public.open_website_demo' | t | escape }}">
              <span class="capability-browser__chrome" aria-hidden="true"><span><i></i><i></i><i></i></span><span>{{ 'public.holm_website_demo' | t }}</span><span>↗</span></span>
              <img src="/demo/_previews/holm-tomrer-960.jpg" srcset="/demo/_previews/holm-tomrer-960.jpg 960w, /demo/_previews/holm-tomrer-1920.jpg 1920w" sizes="(min-width: 990px) 50vw, (min-width: 650px) 45vw, 90vw" width="960" height="600" loading="lazy" alt="{{ 'public.holm_screenshot_alt' | t | escape }}">
            </a>
            <a class="capability-phone" href="/demo/holm-tomrer/" aria-label="{{ 'public.open_mobile_demo' | t | escape }}">
              <span class="capability-phone__speaker" aria-hidden="true"></span>
              <img src="/demo/_previews/holm-tomrer-phone-780.jpg" width="780" height="1688" loading="lazy" alt="{{ 'public.mobile_website_alt' | t | escape }}">
            </a>
          </div>
          <figcaption>{{ 'public.holm_concept_caption' | t }} <a href="/demo/holm-tomrer/">{{ 'public.open_website_demo_link' | t }}</a></figcaption>
        </figure>
        <div class="capability-website-details"><div><span aria-hidden="true">▤</span><strong>{{ 'public.room_for_essentials' | t }}</strong><p>{{ 'public.five_pages' | t }}</p></div><div><span aria-hidden="true">↗</span><strong>{{ 'public.easy_contact' | t }}</strong><p>{{ 'public.contact_details_and_form' | t }}</p></div><div><span aria-hidden="true">✎</span><strong>{{ 'public.three_revision_rounds' | t }}</strong><p>{{ 'public.design_feedback' | t }}</p></div><div><span aria-hidden="true">↻</span><strong>{{ 'public.hosting_maintenance' | t }}</strong><p>{{ 'public.maintenance_included' | t }}</p></div></div>
        <div class="capability__footer"><span>{{ 'public.devices' | t }}</span><a class="arrow-link" href="/pages/hjemmeside">{{ 'public.view_website_plan' | t }}</a></div>
      </article>

      <article class="capability capability--booking">
        <div class="capability__copy">
          <p class="capability__label"><span class="capability__glyph" aria-hidden="true">▦</span> {{ 'public.booking' | t }}</p>
          <h3>{{ 'public.available_appointment' | t }}<br>{{ 'public.one_less_call' | t }}</h3>
          <p>{{ 'public.booking_confirmation' | t }}</p>
        </div>
        <figure class="capability__figure capability__figure--booking">
          <a class="demo-snapshot" href="/demo/salon-nord/book?behandling=dameklip" aria-label="{{ 'public.try_salon_booking' | t | escape }}">
            <span class="capability-browser__chrome" aria-hidden="true"><span><i></i><i></i><i></i></span><span>{{ 'public.salon_booking_demo' | t }}</span><span>↗</span></span>
            <picture><source media="(max-width: 499px)" srcset="/demo/_previews/salon-nord-booking-mobil.jpg"><img src="/demo/_previews/salon-nord-booking-960.jpg" srcset="/demo/_previews/salon-nord-booking-960.jpg 960w, /demo/_previews/salon-nord-booking-1920.jpg 1920w" sizes="(min-width: 650px) 45vw, 90vw" width="960" height="600" loading="lazy" alt="{{ 'public.booking_screenshot_alt' | t | escape }}"></picture>
            <span class="demo-snapshot__action">{{ 'public.try_booking_demo' | t }} <span aria-hidden="true">↗</span></span>
          </a>
          <figcaption>{{ 'public.booking_screenshot_note' | t }}</figcaption>
        </figure>
        <div class="capability__footer"><span>{{ 'public.book_reschedule_cancel' | t }}</span><a class="arrow-link" href="/pages/booking">{{ 'public.view_booking_plan' | t }}</a></div>
      </article>

      <article class="capability capability--shop">
        <div class="capability__copy">
          <p class="capability__label"><span class="capability__glyph" aria-hidden="true">⌑</span> {{ 'public.online_shop' | t }}</p>
          <h3>{{ 'public.from_your_shelf' | t }}<br>{{ 'public.to_their_basket' | t }}</h3>
          <p>{{ 'public.manage_products' | t }}</p>
        </div>
        <figure class="capability__figure capability__figure--shop">
          <a class="demo-snapshot" href="/demo/lervaerk/" aria-label="{{ 'public.open_shop_demo_label' | t | escape }}">
            <span class="capability-browser__chrome" aria-hidden="true"><span><i></i><i></i><i></i></span><span>{{ 'public.lervaerk_shop_demo' | t }}</span><span>↗</span></span>
            <picture><source media="(max-width: 499px)" srcset="/demo/_previews/lervaerk-kurv-mobil.jpg?v=photo-20261101"><img src="/demo/_previews/lervaerk-kurv-960.jpg?v=photo-20261101" srcset="/demo/_previews/lervaerk-kurv-960.jpg?v=photo-20261101 960w, /demo/_previews/lervaerk-kurv-1920.jpg?v=photo-20261101 1920w" sizes="(min-width: 650px) 45vw, 90vw" width="960" height="600" loading="lazy" alt="{{ 'public.shop_basket_alt' | t | escape }}"></picture>
            <span class="demo-snapshot__action">{{ 'public.open_shop_demo' | t }} <span aria-hidden="true">↗</span></span>
          </a>
          <figcaption>{{ 'public.shop_screenshot_note' | t }}</figcaption>
        </figure>
        <div class="capability__footer"><span>{{ 'public.products_variants_basket' | t }}</span><a class="arrow-link" href="/pages/webshop">{{ 'public.view_shop_plan' | t }}</a></div>
      </article>
    </div>
    <p class="studio-capabilities__note">{{ 'public.demo_screenshots_note' | t }}</p>
  </div>
</section>
{% schema %}
{
  "name": "Bureau: konkrete muligheder",
  "settings": [],
  "presets": [{ "name": "Bureau: konkrete muligheder" }]
}
{% endschema %}
