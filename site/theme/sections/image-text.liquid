{%- comment -%}
  Tekst med billede eller pladsholder. Bruges bl.a. på Om os.
  Uden billede vises en neutral, markeret pladsholder i temaeditoren – og intet på den live side.
{%- endcomment -%}
<section class="section section--{{ section.settings.scheme }} image-text image-text--{{ section.settings.image_position }}" id="{{ section.settings.anchor | default: section.id | handle }}">
  <div class="container image-text__inner">
    <div class="image-text__content">
      {% render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
      <div class="rte image-text__text" data-reveal>{{ section.settings.text }}</div>
      {% render 'button', label: section.settings.link_label, url: section.settings.link, style: 'secondary' %}
    </div>
    {%- if section.settings.image != blank -%}
      <div class="image-text__media" data-reveal>
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag: widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 990px) 45vw, 100vw', loading: 'lazy', class: 'image-text__img'
        }}
      </div>
    {%- elsif section.settings.statement != blank -%}
      <div class="image-text__media image-text__statement" data-reveal>
        <p>{{ section.settings.statement }}</p>
      </div>
    {%- elsif request.design_mode -%}
      <div class="image-text__media image-text__placeholder">[BILLEDE AF TEAM ELLER ARBEJDSPLADS]</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Tekst og billede",
  "tag": "div",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Farvetema", "options": [
      { "value": "light", "label": "Lyst" }, { "value": "surface", "label": "Lys flade" }, { "value": "dark", "label": "Mørkt" }
    ], "default": "light" },
    { "type": "select", "id": "image_position", "label": "Billedplacering", "options": [
      { "value": "right", "label": "Højre" }, { "value": "left", "label": "Venstre" }
    ], "default": "right" },
    { "type": "text", "id": "anchor", "label": "Anker-id" },
    { "type": "text", "id": "eyebrow", "label": "Lille overskrift" },
    { "type": "inline_richtext", "id": "heading", "label": "Overskrift", "default": "Overskrift" },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Tekst</p>" },
    { "type": "image_picker", "id": "image", "label": "Billede" },
    { "type": "inline_richtext", "id": "statement", "label": "Udsagn (vises, hvis der ikke er billede)" },
    { "type": "text", "id": "link_label", "label": "Knaptekst" },
    { "type": "url", "id": "link", "label": "Knaplink" }
  ],
  "presets": [{ "name": "Tekst og billede" }]
}
{% endschema %}
