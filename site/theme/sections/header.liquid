{%- comment -%}
  Header: logo, få menupunkter, kundelogin og én knap ("Aftal en demo").
  Der er intet fast kurvikon. Har en besøgende lagt noget i kurven, indsætter serveren et lille
  kurvlink (<!--cart-count--> i src/site/app.ts › personalize), så kurven stadig kan findes.
{%- endcomment -%}
{%- liquid
  assign company = settings.company_name | default: shop.name
  assign cta_url = section.settings.cta_link | default: pages['kontakt'].url | default: '/pages/kontakt'
  assign login_url = section.settings.login_link | default: 'https://kunde.veyro.dk/login'
  assign menu = section.settings.menu
-%}
<header class="site-header{% if section.settings.sticky %} site-header--sticky{% endif %}" data-header>
  <div class="container site-header__inner">
    <a class="logo" href="{{ routes.root_url }}" aria-label="{{ company | escape }} – {{ 'general.home' | t }}">
      {%- if settings.logo != blank -%}
        {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio | round -%}
        {{
          settings.logo
          | image_url: width: 520
          | image_tag: class: 'logo__image', width: settings.logo_width, height: logo_height, alt: company, loading: 'eager'
        }}
      {%- else -%}
        <span class="logo__text">{{ company | escape }}</span><span class="logo__dot" aria-hidden="true">.</span>
      {%- endif -%}
    </a>

    {%- if menu.links.size > 0 -%}
      <nav class="nav" aria-label="{{ 'general.main_navigation' | t }}">
        <ul class="nav__list" role="list">
          {%- for link in menu.links -%}
            <li><a class="nav__link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% elsif link.child_active %} data-active{% endif %}>{{ link.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="site-header__actions">
      <!--cart-count-->
      {%- if section.settings.login_label != blank -%}
        <a class="nav__link site-header__login" href="{{ login_url }}">{{ section.settings.login_label | escape }}</a>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a class="btn btn--primary btn--sm site-header__cta" href="{{ cta_url }}">{{ section.settings.cta_label | escape }}</a>
      {%- endif -%}
      {%- if menu.links.size > 0 -%}
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="MobileNav" data-nav-toggle>
          <span class="nav-toggle__label" data-nav-toggle-label>{{ 'general.menu' | t }}</span>
          <span class="nav-toggle__bars" aria-hidden="true"><span></span><span></span></span>
        </button>
      {%- endif -%}
    </div>
  </div>

  {%- if menu.links.size > 0 -%}
    <div class="mobile-nav" id="MobileNav" hidden data-mobile-nav>
      <nav class="container" aria-label="{{ 'general.main_navigation' | t }}">
        <ul class="mobile-nav__list" role="list">
          {%- for link in menu.links -%}
            <li><a class="mobile-nav__link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
          {%- endfor -%}
          {%- if section.settings.login_label != blank -%}
            <li><a class="mobile-nav__link" href="{{ login_url }}">{{ section.settings.login_label | escape }}</a></li>
          {%- endif -%}
        </ul>
        {%- if section.settings.cta_label != blank -%}
          <a class="btn btn--primary btn--block" href="{{ cta_url }}">{{ section.settings.cta_label | escape }}</a>
        {%- endif -%}
        <p class="mobile-nav__meta">
          {%- unless settings.company_email contains '[' -%}<a href="mailto:{{ settings.company_email }}">{{ settings.company_email }}</a>{%- endunless -%}
          {%- if settings.company_phone != blank -%}<a href="tel:{{ settings.company_phone | remove: ' ' }}">{{ settings.company_phone }}</a>{%- endif -%}
        </p>
      </nav>
    </div>
  {%- endif -%}
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu", "info": "Hold menuen kort: Løsninger, Eksempler, Priser, Om os og Kontakt." },
    { "type": "checkbox", "id": "sticky", "label": "Fastgør header ved scroll", "default": true },
    { "type": "text", "id": "cta_label", "label": "Knaptekst", "default": "Aftal en demo" },
    { "type": "url", "id": "cta_link", "label": "Knaplink", "info": "Tomt felt linker til siden med håndtaget „kontakt“." },
    { "type": "text", "id": "login_label", "label": "Tekst for kundelogin", "default": "Kundelogin", "info": "Tomt felt skjuler linket." },
    { "type": "url", "id": "login_link", "label": "Link til kundelogin", "info": "Tomt felt linker til https://kunde.veyro.dk/login." }
  ]
}
{% endschema %}
