<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_bg }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- unless request.page_type == '404' -%}
      {%- for language in site_languages -%}
        <link rel="alternate" hreflang="{{ language.code }}" href="{{ language.canonical }}">
        {%- if language.code == 'da' -%}<link rel="alternate" hreflang="x-default" href="{{ language.canonical }}">{%- endif -%}
      {%- endfor -%}
    {%- endunless -%}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
    {%- else -%}
      {%- comment -%} Faste adresser uden ?v=: Google viser ikonet i søgeresultaterne og vil ikke have, at adressen skifter {%- endcomment -%}
      <link rel="icon" href="/favicon.ico" sizes="48x48">
      <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
      <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-192.png">
    {%- endif -%}
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">

    {%- liquid
      assign company = settings.company_name | default: shop.name
      if request.page_type == 'index'
        assign full_title = page_title | append: ' – ' | append: company
        if page_title == shop.name or page_title == company
          assign tagline_short = settings.company_tagline | split: ':' | first | split: '.' | first | strip
          assign full_title = company | append: ' – ' | append: tagline_short
          if full_title.size > 65
            assign full_title = full_title | truncatewords: 8, ''
          endif
        endif
      else
        assign full_title = page_title | append: ' – ' | append: company
      endif
      if current_tags
        assign full_title = full_title | append: ' – ' | append: current_tags | join: ', '
      endif
      if current_page != 1
        assign full_title = full_title | append: ' – side ' | append: current_page
      endif
    -%}
    <title>{{ full_title | escape }}</title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- elsif settings.company_tagline != blank -%}
      <meta name="description" content="{{ settings.company_tagline | escape }}">
    {%- endif -%}

    {% render 'meta-tags', full_title: full_title %}

    {{ 'manrope-latin-variable.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

    {%- render 'theme-styles' -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'motion.css' | asset_url | stylesheet_tag }}
    {{ 'forms-dark.css' | asset_url | stylesheet_tag }}
    {{ 'plan-picker.css' | asset_url | stylesheet_tag }}
    {{ 'project-gallery.css' | asset_url | stylesheet_tag }}
    {{ 'studio-capabilities.css' | asset_url | stylesheet_tag }}
    {{ 'studio-depth.css' | asset_url | stylesheet_tag }}
    {{ 'brand.css' | asset_url | stylesheet_tag }}

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
    <script src="{{ 'language-switch.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'motion.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'plan-picker.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'project-gallery.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'interaction-audio.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.name | handle }}--{{ template.suffix | handle }}{% endif %}{% if settings.animations %} has-motion{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cookie_banner_enabled -%}
      {% render 'cookie-consent' %}
    {%- endif -%}

    {%- render 'theme-strings' -%}
  </body>
</html>
