@downloadArea path /webmail-downloads /webmail-downloads/*
@desktopInstaller {
	method GET HEAD
	path_regexp installer ^/webmail-downloads/Veyro-Mail-([0-9]{1,6}[.][0-9]{1,6}[.][0-9]{1,6}(-beta[.][0-9]{1,6})?)-(mac-(arm64|x64)[.]dmg|win-x64[.]exe)$
}
@desktopUpdate {
	method GET HEAD
	path /webmail-downloads/update.json
}
handle @downloadArea {
	handle @desktopUpdate {
		root * /srv/veyro-mail-downloads
		uri strip_prefix /webmail-downloads
		header Content-Type application/json
		header Cache-Control no-store
		header X-Content-Type-Options nosniff
		file_server
	}
	handle @desktopInstaller {
		root * /srv/veyro-mail-downloads/{re.installer.1}
		uri strip_prefix /webmail-downloads
		header Content-Type application/octet-stream
		header Content-Disposition "attachment; filename=\"{http.request.uri.path.file}\""
		header X-Content-Type-Options nosniff
		file_server
	}
	respond 404
}

@signedDesktopRelease {
	method HEAD POST PUT
	path /webmail-release-upload/v1/begin /webmail-release-upload/v1/mac-apple /webmail-release-upload/v1/mac-intel /webmail-release-upload/v1/windows /webmail-release-upload/v1/publish
}
handle @signedDesktopRelease {
	request_body {
		max_size 8MiB
	}
	reverse_proxy 127.0.0.1:18147 {
		header_up X-Veyro-Release-IP {remote_host}
	}
}

@recoveryPage {
	method GET HEAD POST
	path /reset-password
	expression `{http.request.orig_uri}.matches(r'^/reset-password[?]token=[A-F0-9]{6}(-[A-F0-9]{6}){4}$')`
}
handle @recoveryPage {
	reverse_proxy 127.0.0.1:80 {
		header_up Host post.veyro.dk
		header_up X-Forwarded-Proto https
		header_up -X-Api-Key
		header_up -X-Original-URL
		header_up -X-Rewrite-URL
		header_up -X-Real-IP
		header_up -Forwarded
		header_down Referrer-Policy "no-referrer"
		header_down Cache-Control "no-store, private"
	}
}

@teamUpload {
	method POST
	path /webmail-api/api/team/files
}
@ordinaryMailBody not {
	method POST
	path /webmail-api/api/team/files
}
@oversizedTeamUpload {
	method POST
	path /webmail-api/api/team/files
	expression `{http.request.header.Content-Length} != '' && int({http.request.header.Content-Length}) > 7340032`
}
@oversizedOrdinaryMailBody {
	not {
		method POST
		path /webmail-api/api/team/files
	}
	expression `{http.request.header.Content-Length} != '' && int({http.request.header.Content-Length}) > 262144`
}
handle /webmail-api/api/* {
	route {
		# Caddy 2.6 reports a proxy read failure as 502. Reject declared
		# oversize bodies before proxying so clients receive an explicit 413.
		respond @oversizedTeamUpload "Request body too large." 413
		respond @oversizedOrdinaryMailBody "Request body too large." 413
		request_body @teamUpload {
			max_size 7MiB
		}
		request_body @ordinaryMailBody {
			max_size 256KiB
		}
		uri strip_prefix /webmail-api
		reverse_proxy 127.0.0.1:18082 {
			header_up -Authorization
			header_up -X-Original-URL
			header_up -X-Rewrite-URL
		}
	}
}
